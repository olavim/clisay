// Forms an anchor near the bottom of the stack. Then flags a value and shares it on every iteration, deep in a recursion.
type Counter {
    pub var n = 0;
    pub fn bump(&var this) { this.n += 1; }
}
type Log {
    pub var c = Counter{n: 0};
    pub fn add(&var this) { &this.c.bump(); }
}

fn share_at_depth(depth) {
    if depth > 0 {
        say r = share_at_depth(depth - 1);
        return r;
    }
    say var log = Log{c: Counter{n: 0}};
    &log.add();
    say kept = [log];
    return kept.length();
}

say var outer = Log{c: Counter{n: 0}};
say var i = 0;
while i < 2000 {
    &outer.add();
    share_at_depth(200);
    i = i + 1;
}
print(outer.c.n);
