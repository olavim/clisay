fn stash(&var bin, item) { &bin.push(item); }
say var sink = [];
say var m = [1, 2];
stash(&sink, m);
m[0] = 9;
sink[0][1] = 8;
print(sink[0][0]); // expect: 1
print(m[1]); // expect: 2

// @split
type Sink { pub var item; init(this) { this.item = 0; } pub fn keep(&var this, x) { this.item = x; } }
say var s = Sink();
say var m = [1];
&s.keep(m);
m[0] = 9;
print(s.item[0]); // expect: 1

// @split
type Box { pub var inner; pub fn hideIn(this, &var sink) { &sink.push(this); } }
say var sink = [];
say var c = Box { inner: 5 };
c.hideIn(&sink);
c.inner = 6;
print(sink[0].inner); // expect: 5

// @split
type Counter { pub var n; init(this) { this.n = 0; } pub fn reader(this) { return () => this.n; } }
say var c = Counter();
say r = c.reader();
c.n = 5;
print(r()); // expect: 0
