fn f(x) { say a = [x]; }
say m = [1];
f(m);
print(m[0]); // expect: 1

// @split
fn f(x) { say a = [x]; }
say m = [1];
f(m);
print(m[0]); // expect: 1

// @split
fn f(x) { say a = [x]; a[0][0] = 5; }
say m = [1];
f(m);
print(m[0]); // expect: 5

// @split
fn f(x)! { say a = [x]; return a[0][0]; }
say m = [7];
print(f(m)); // expect: 7
