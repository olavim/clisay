fn f(x) { throw [x]; }
say m = [1];
try { f(m); } catch (e) { print("caught"); } // expect: caught

// @split
fn f(x) { try { throw [x]; } catch (e) { return [e]; } }
say m = [1];
print(f(m)[0][0][0]); // expect: 1

// @split
fn f(x) { try { throw [x]; } catch (e) { if (e != null) { print(e[0][0]); } } } // expect: 1
say m = [1];
f(m);

// @split
fn hand(z) { return z; }
say m = [1];
print(hand(m)[0]); // expect: 1

// @split
fn dies(y) { say var a = [y]; a[0][0] = 7; print(a[0][0]); } // expect: 7
say var m = [1];
dies(m);
print(m[0]); // expect: 1

// @split
type Wrap { pub var w; init(this) { this.w = 0; } }
fn viaLiteral(x) { say a = [x]; print(a[0][0]); } // expect: 1
fn viaConstruct(x) { say c = Wrap { w: x }; print(c.w[0]); } // expect: 1
fn viaStore(x) { say var s = Wrap(); s.w = x; print(s.w[0]); } // expect: 1
say m = [1];
viaLiteral(m);
viaConstruct(m);
viaStore(m);

// @split
fn outer(x) { say a = [x]; say slot = Ref(0); say inner = () => { @slot = a; }; inner(); return @slot[0][0]; }
say m = [1];
print(outer(m)); // expect: 1

// @split
type Wrap { pub var w; init(this) { this.w = 0; } }
say sink = Ref([0]);
fn keep(x) { @sink[0] = Wrap { w: x }; }
say m = [1];
keep(m);
print(@sink[0].w[0]); // expect: 1

// @split
fn outer(x) { say inner = () => { say a = [x]; print(a[0][0]); }; inner(); } // expect: 1
say m = [1];
outer(m);
