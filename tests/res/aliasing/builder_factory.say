type UserBuilder {
  pub var name;
  init(this) { this.name = ""; }
  pub fn setName(&var this, n) { this.name = n; return this; }
  pub fn build(this) { return this.name; }
}
fn getBuilder() {
  say var b = UserBuilder();
  &b.setName("default");
  return b;
}
say builder = getBuilder();
say user = builder.build();
print(user); // expect: default
