say kept = Ref([]);
fn f(var x) { say cb = () => { x[0] = 5; return x[0]; }; @kept = cb; } // error: Cannot write through `x`; a closure captures its value, not its binding
say m = [1];
f(m);
print(@kept());
print(m[0]);
// @split
say kept = Ref([]);
fn f(x) { say cb = () => { return x[0]; }; @kept = cb; }
say m = [1];
f(m);
print(@kept()); // expect: 1
// @split
fn drop(c) { }
fn get(x) { return x; }
say f = get;
say var keep = [];
say var e = [0];
drop(e);
&keep.push(f(e));
e[0] = 3;
print(keep[0][0]); // expect: 0
print(e[0]); // expect: 3
// @split
say kept = Ref([]);
fn f(x) { say cb = () => { return x[0]; }; @kept = cb; }
say var m = [1];
f(m);
m[0] = 9;
print(@kept()); // expect: 1
print(m[0]); // expect: 9
// @split
fn wrap() {
    say held = Ref([0]);
    fn inner(y) { @held = y; }
    inner([1]);
    return @held;
}
say var r = wrap();
r[0] = 9;
print(r[0]); // expect: 9
