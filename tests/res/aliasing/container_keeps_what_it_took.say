fn run() {
    say var sink = [];
    fn stash() {
        say var a = [[0]];
        &sink.push(a[0]); // error: Cannot take an anchor into `sink`; it is captured
        a[0][0] = 99;
        print(sink[0][0]);
    }
    stash();
}
run();
// @split
fn run() {
    say var sink = [];
    say var a = [[0]];
    &sink.push(a[0]);
    a[0][0] = 99;
    print(sink[0][0]); // expect: 0
}
run();
