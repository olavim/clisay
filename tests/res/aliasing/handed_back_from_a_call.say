fn id(c) { return c; }
say a = [];
say var b = id(a);
&b.push(1);
print(b.length()); // expect: 1

// @split
say var a = [0];
{ say var b = a; b[0] = 1; }
a[0] = 2;
print(a[0]); // expect: 2

// @split
say var a = [0];
{
    say var b = a;
    { say var c = b; c[0] = 1; }
    b[0] = 2;
}
a[0] = 3;
print(a[0]); // expect: 3
