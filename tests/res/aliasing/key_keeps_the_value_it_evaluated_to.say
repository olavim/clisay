say var d = {};
d[[1]] = [0];
say var k = [1];
d[k][0] = (k[0] = 5);
print(d[[1]][0]); // expect: 5
print(k[0]); // expect: 5

// @split
say var d = {};
say var k = [1];
d[k] = (k[0] = 5);
print(d[[1]]); // expect: 5
print(d.containsKey([5])); // expect: false

// @split
say var d = {};
d[[1]] = [0];
say var b = [[1]];
b[0][0] = 1;
d[b[0]][0] = (b[0][0] = 9);
print(d[[1]][0]); // expect: 9
print(b[0][0]); // expect: 9

// @split
fn grow(&var xs) { &xs.push(2); return 7; }
say var d = {};
d[[1]] = [0];
say var k = [1];
d[k][0] = grow(&k);
print(d[[1]][0]); // expect: 7
print(k.length()); // expect: 2

// @split
say var d = {};
d[[1]] = [0];
say var k = [1];
d[k][0] = &k.push(2);
print(d[[1]][0]); // expect: null
print(k.length()); // expect: 2

// @split
say var d = {};
d[[1]] = [0];
say var k = [1];
say r = (d[k][0] = (k[0] = 5));
print(r); // expect: 5
print(d[[1]][0]); // expect: 5

// @split
say var d = {};
d[[1]] = {};
d[[1]][[2]] = [0];
say var k = [1];
say var j = [2];
say r = (d[k][j][0] = (k[0] = 5) + (j[0] = 6));
print(r); // expect: 11
print(d[[1]][[2]][0]); // expect: 11
