say var a = [[0]];
say var e = a[0];
e[0] = 1;
a[0][0] = 2;
print(e[0]); // expect: 1
print(a[0][0]); // expect: 2

// @split
type T { pub var x; init(this, v) { this.x = v; } }
say a = [[0]];
say var e = a[0];
say var t = T(e);
e[0] = 1;
t.x[0] = 2;
print(e[0]); // expect: 1
print(t.x[0]); // expect: 2

// @split
say var a = [[0]];
say var e = a[0];
e[0] = 1;
&a[0].push(2);
print(a[0].length()); // expect: 2
print(e.length()); // expect: 1

// @split
say var a = [[0]];
say var e = a[0];
e[0] = 1;
a[0][0] += 2;
print(a[0][0]); // expect: 2
print(e[0]); // expect: 1

// @split
say var a = [[0], [0]];
a[0][0] = 1;
a[0][0] = 2;
a[1][0] = 3;
print(a[0][0]); // expect: 2
print(a[1][0]); // expect: 3

// @split
say var a = [[0]];
{
    say var e = a[0];
    e[0] = 1;
}
a[0][0] = 2;
print(a[0][0]); // expect: 2

// @split
say a = [[0]];
say var e = a[0];
e[0] = 7;
print(a[0][0]); // expect: 0

// @split
say a = [[0]];
say var b = [a[0]];
b[0][0] = 1;
print(b[0][0]); // expect: 1

// @split
say a = [[0]];
say var b = [a[0]];
b[0][0] = 7;
print(a[0][0]); // expect: 0

// @split
say var a = [[0]];
say b = [a[0]];
a[0][0] = 1;
print(a[0][0]); // expect: 1
print(b[0][0]); // expect: 0

// @split
say var a = [[0]];
say var b = [];
&b.push(a[0]);
a[0][0] = 1;
print(a[0][0]); // expect: 1
print(b[0][0]); // expect: 0

// @split
say a = [[0], [0]];
say var b = [];
&b.push(a[0]);
&b.push(a[1]);
print(b.length()); // expect: 2

// @split
say var b = [];
&b.push([0]);
print(b.length()); // expect: 1
