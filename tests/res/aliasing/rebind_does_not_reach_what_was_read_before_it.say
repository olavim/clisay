say var a = [0];
a[0] = 1;
say var keep = a;
a = [9];
keep[0] = 5;
print(keep[0]); // expect: 5
print(a[0]); // expect: 9

// @split
fn make() { return [0]; }
say var a = make();
a[0] = 1;
say var keep = a;
a = make();
keep[0] = 5;
print(keep[0]); // expect: 5

// @split
say var x = [0];
say var z = [0];
{ say inner = [[1]]; x = inner[0]; z = inner[0]; }
x[0] = 5;
x = [9];
z[0] = 6;
print(z[0]); // expect: 6

// @split
say var x = [0];
say var z = [0];
{ say inner = [[1]]; x = inner[0]; z = inner[0]; }
x[0] = 5;
z[0] = 6;
print(x[0]); // expect: 5
print(z[0]); // expect: 6
