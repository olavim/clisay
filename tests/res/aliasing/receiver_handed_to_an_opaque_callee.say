fn take(v) { return v; }
type T {
    pub var v;
    init(this) { this.v = 1; }
    pub fn m(var this, cb) { cb(this); this.v = 2; }
}
say var a = T();
a.m(take);
print(a.v); // expect: 1

// @split
fn look(v) { return v.v; }
type T {
    pub v;
    init(this) { this.v = 1; }
    pub fn m(var this, cb) { return cb(this); }
}
say a = T();
print(a.m(look)); // expect: 1
