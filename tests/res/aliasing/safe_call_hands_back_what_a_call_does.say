fn take(v) { return v; }
fn hand(x) { return x; }
fn give(a) { return take(hand(a)); }
print(give(7)); // expect: 7

// @split
fn take(v) { return v; }
fn hand(x) { return x; }
fn give(a) { return take(hand?(a)!); }
print(give(7)); // expect: 7

// @split
fn take(v) { return v; }
fn hand(x) { return x; }
fn give(a) { return take(hand?(a)!); }
print(give([1])[0]); // expect: 1

// @split
say kept = Ref([]);
fn keep(v) { @kept = [v]; }
fn give(a) { keep(a); }
say var m = [1];
give(m);
m[0] = 9;
print(@kept![0][0]); // expect: 1

// @split
say kept = Ref([]);
fn keep(v) { @kept = [v]; }
fn give(a) { keep?(a); }
say var m = [1];
give(m);
m[0] = 9;
print(@kept![0][0]); // expect: 1

// @split
fn hand(x) { return x; }
fn give(a) { return hand?(a)! + 1; }
print(give(7)); // expect: 8

// @split
fn f(var v) { &v.push(1); }
say m = [0];
f?(m);
print(m.length()); // expect: 1
