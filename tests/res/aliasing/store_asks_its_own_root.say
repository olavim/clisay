fn id(c) { return c; }
say fns = [id];
say var a = [0];
say var b = fns[0](a);
a[0] = 1;
print(a[0]); // expect: 1
print(b[0]); // expect: 0

// @split
fn id(c) { return c; }
say fns = [id];
say a = [0];
say var b = fns[0](a);
b[0] = 1;
print(b[0]); // expect: 1

// @split
type T { pub var x; init(this, v) { this.x = v; } }
fn id(c) { return c; }
say fns = [id];
say var a = T(0);
say b = fns[0](a);
a.x = 1;
print(a.x); // expect: 1
print(b.x); // expect: 0

// @split
type T { pub var x; init(this, v) { this.x = v; } }
fn id(c) { return c; }
say fns = [id];
say a = T(0);
say var b = fns[0](a);
b.x = 1;
print(b.x); // expect: 1

// @split
fn id(c) { return c; }
say fns = [id];
say var a = [];
say b = fns[0](a);
&a.push(1);
print(a.length()); // expect: 1
print(b.length()); // expect: 0

// @split
fn id(c) { return c; }
say fns = [id];
say a = [7];
say var b = fns[0](a);
print(a.length()); // expect: 1
&b.push(8);
print(b.length()); // expect: 2

// @split
say a = [0];
say b = a;
print(b[0]); // expect: 0
