say sink = Ref([]);
say other = Ref([]);
fn keep(v) { sink.mutate((&var list) => { &list.push(v); }); }
fn keep2(v) { other.mutate((&var list) => { &list.push(v); }); }
keep("hi");
keep2("hi");
print(@sink[0]); // expect: hi
print(@other[0]); // expect: hi

// @split
type T { pub v; }
say t = T { v: 1 };
say sink = Ref([]);
say other = Ref([]);
fn keep(v) { sink.mutate((&var list) => { &list.push(v); }); }
fn keep2(v) { other.mutate((&var list) => { &list.push(v); }); }
keep(t);
keep2(t);
print(@sink[0].v); // expect: 1
print(@other[0].v); // expect: 1

// @split
say sink = Ref([]);
fn keep(v) { sink.mutate((&var list) => { &list.push(v); }); }
say var a = [[0]];
keep(a[0]);
a[0][0] = 1;
print(@sink[0][0]); // expect: 0
print(a[0][0]); // expect: 1
