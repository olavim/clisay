say var sink = [];
fn get() { return sink; }
say var a = [[0]];
say var got = get();
&got.push(a[0]);
a[0][0] = 1;
print(a[0][0]); // expect: 1

// @split
say var sink = [];
say var a = [[0]];
&sink.push(a[0]);
a[0][0] = 1;
print(sink[0][0]); // expect: 0
print(a[0][0]); // expect: 1

// @split
say sink = [];
fn get() { return sink; }
say var got = get();
&got.push([0]);
print(sink.length()); // expect: 0

// @split
say sink = [];
fn get() { return sink; }
get().push([0]); // error: `push` wants an anchor receiver
