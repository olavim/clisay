fn touch(&var a, k) { say var e = &a[k]; e[0] = e[0] + 1; return; }
say var arr = [[0]];
say kept = arr;
say var i = 0;
touch(&arr, i);
touch(&arr, i);
print(arr[0][0]); // expect: 2
print(kept[0][0]); // expect: 0

