// @split
type Token { pub v; init(this, x) { this.v = x; } }
obligation parsed { witness Token; discharge to use; }
type U { pub var z = 1; }
type T { pub var y = U(); }
fn make() { return [Token(1)]; }
say bag = make();
say var x = T();
say var r = &x.y.z;
try { x.y = bag[0]; } catch (e) { print("refused"); } // expect: refused
r = 5;
print(x.y.z); // expect: 5

// @split
type U { pub var z = 1; pub var w = 1; }
type T { pub var y = U(); }
say var x = T();
say var r = &x.y.z;
say k = x;
x.y.w = 2;
r = 5;
print(x.y.z); // expect: 5
print(k.y.z); // expect: 1
say var s = &x.y.w;
s = 3;
r = 6;
print(x.y.w); // expect: 3
print(x.y.z); // expect: 6

