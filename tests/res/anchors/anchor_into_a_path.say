fn bump(&var n) { n = n + 1; }

say var a = [1, 2, 3];
bump(&a[1]);
print(a[1]); // expect: 3

// @split
type T { pub var v = 0; }
fn bump(&var n) { n = n + 1; }

say var t = T();
bump(&t.v);
print(t.v); // expect: 1

// @split
type G { pub var nodes = []; }
fn bump(&var n) { n = n + 1; }

say var g = G();
g.nodes = [1, 2, 3];
bump(&g.nodes[2]);
print(g.nodes[2]); // expect: 4

// @split
fn bump(&var n) { n = n + 1; }

say var a = [[1, 2], [3, 4]];
bump(&a[1][0]);
print(a[1][0]); // expect: 4

// @split
fn set(&var n, v) { n = v; }

say var a = [1, 2, 3];
say var t = &a[0];
t = 9;
print(a[0]); // expect: 9
set(&t, 8);
print(a[0]); // expect: 8
