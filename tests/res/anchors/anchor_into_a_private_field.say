fn bump(&var n) { n = n + 1; }

type C {
    var v;
    pub var w;
    init(this, v) { this.v = v; this.w = v; }
    pub fn go(var this) {
        bump(&this.v);
        bump(&this.w);
        return this.v + this.w;
    }
}

print(C(1).go()); // expect: 4

// @split
fn bump(&var n) { n = n + 1; }

type C {
    var rows;
    init(this, rows) { this.rows = rows; }
    pub fn go(var this) {
        bump(&this.rows[1]);
        return this.rows[1];
    }
}

print(C([5, 6]).go()); // expect: 7

// @split
type Inner { pub var n; init(this, n) { this.n = n; } }

fn bump(&var n) { n = n + 1; }

type C {
    var inner;
    init(this, inner) { this.inner = inner; }
    pub fn go(var this) {
        bump(&this.inner.n);
        return this.inner.n;
    }
}

print(C(Inner(4)).go()); // expect: 5

// @split
fn bump(&var n) { n = n + 1; }

type C {
    var v;
    var rows;
    init(this, v, rows) { this.v = v; this.rows = rows; }
    pub fn go(var this) {
        bump(&this["v"]);
        bump(&this["rows"][1]);
        return this.v + this.rows[1];
    }
}

print(C(1, [5, 6]).go()); // expect: 9
