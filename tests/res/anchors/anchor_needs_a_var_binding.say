fn set(&var n) { n = 1; }

say var a = 0;
set(&a);
print(a); // expect: 1

// @split
type T { pub var v = 0; }
fn set(&var n) { n = 1; }

say var t = T();
set(&t.v);
print(t.v); // expect: 1

// @split
say var a = 0;
say var b = &a;
b = 2;
print(a); // expect: 2

// @split
fn set(&var n) { n = 1; }

say a = 0;
set(&a); // error: Cannot anchor non-var binding `a`
