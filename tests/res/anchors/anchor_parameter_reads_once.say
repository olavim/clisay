type V { pub var items = [1, 2, 3]; }
fn f(&var x) { x[0] = x[1] + x[2]; return x[0]; }

say var v = V();
print(f(&v.items)); // expect: 5
print(v.items[0]); // expect: 5

// @split
type V { pub var items = [1, 2, 3]; }
fn f(&var x) {
    say var first = x[0];
    x = [7, 7];
    x[0] = 9;
    return first + x[0];
}

say var v = V();
print(f(&v.items)); // expect: 10
print(v.items[0]); // expect: 9
print(v.items[1]); // expect: 7

// @split
fn sum(&var a) { return a[0] + a[1] + a[2]; }

say var nums = [1, 2, 3];
print(sum(&nums)); // expect: 6

// @split
fn g(&var y) { y = [5]; }
fn f(&var x) { g(&x); return x[0]; }

say var a = [1];
print(f(&a)); // expect: 5
print(a[0]); // expect: 5
