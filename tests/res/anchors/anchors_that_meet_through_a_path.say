fn f(&var x, &var y) { x = 1; y = 2; }

say var a = [[0], [0]];
say var i = 0;
say var j = 1;
f(&a[i], &a[j][i]);
print(a[0]); // expect: 1
print(a[1][0]); // expect: 2

// @split
fn f(&var x, &var y) { x = 1; y = 2; }

say var a = [[0]];
say var i = 0;
say var j = 0;
f(&a[i], &a[j][i]); // error: Uncaught exception: "two anchors in one call name the same storage"

// @split
fn f(&var x, &var y) { x = 1; y = 2; }

say var a = [0, 0];
say var p = &a[0];
say var q = &a[1];
f(&p, &q);
print(a[0]); // expect: 1
print(a[1]); // expect: 2

// @split
fn f(&var x, &var y) { x = 1; y = 2; }

say var a = [0];
say var i = 0;
say var p = &a[i];
say var q = &a[i];
f(&p, &q); // error: Uncaught exception: "two anchors in one call name the same storage"

// @split
type G { pub var rows = []; }
fn f(&var x, &var y) { x = 1; y = 2; }

say var g = G();
g.rows = [[0], [0]];
say var i = 0;
say var j = 1;
f(&g.rows[i], &g.rows[j]);
print(g.rows[0]); // expect: 1
print(g.rows[1]); // expect: 2

