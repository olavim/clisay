say var a = 1;
a = 2;
print(a); // expect: 2

// @split
say var b = [1];
b = [2];
b[0] = 3;
print(b[0]); // expect: 3

// @split
say c = [1];
c[0] = 9;
print(c[0]); // expect: 9

// @split
say var d = [1];
d = [2];
print(d[0]); // expect: 2

// @split
say e = 1;
e = 2; // error: Cannot reassign binding `e`
