type Inner { pub var c; init(this, c) { this.c = c; } }
type Outer { pub var b; init(this, b) { this.b = b; } }

say var o = Outer(Inner(0));
say copy = o;
o.b.c = 1;
print(o.b.c); // expect: 1
print(copy.b.c); // expect: 0

// @split
type Inner { pub var c; init(this, c) { this.c = c; } }
type Outer { pub var b; init(this, b) { this.b = b; } }

say var o = Outer(Inner(0));
say copy = o;
o?.b.c = 1;
print(o.b.c); // expect: 1
print(copy.b.c); // expect: 0

// @split
type Inner { pub var c; init(this, c) { this.c = c; } }
type Outer { pub var b; init(this, b) { this.b = b; } }

say var o = Outer(Inner(0));
say copy = o;
o.b?.c = 1;
print(o.b.c); // expect: 1
print(copy.b.c); // expect: 0
