say var calls = 0;
fn idx() { calls = calls + 1; return 0; }
say n = [12];
n[idx()] += 1;
n[idx()] -= 3;
n[idx()] *= 4;
n[idx()] /= 2;
n[idx()] &= 30;
n[idx()] |= 1;
n[idx()] ^= 2;
n[idx()] <<= 2;
n[idx()] >>= 1;
print(calls); // expect: 9
say b = [true];
b[idx()] &&= false;
b[idx()] ||= true;
print(calls); // expect: 11
print(b[0]); // expect: true

say var runs = 0;
fn side() { runs = runs + 1; return true; }
say s = [false, true];
s[idx()] &&= side();
print(s[0]); // expect: false
print(runs); // expect: 0
say u = [true];
u[idx()] ||= side();
print(runs); // expect: 0
say v = [true];
v[idx()] &&= side();
print(runs); // expect: 1
