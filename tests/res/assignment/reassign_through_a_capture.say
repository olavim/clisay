fn run() {
    say b = 1;
    say f = () => { b = 2; return 1; }; // error: Cannot assign to `b`; a closure captures its value, not its binding
    f();
    print(b);
}
run();

// @split
fn run() { say b = 1; b = 2; print(b); } // error: Cannot reassign binding `b`
run();

// @split
fn run(p) { p = 2; print(p); } // error: Cannot reassign binding `p`
run(1);

// @split
fn run(p) {
    say f = () => { p = 2; return 1; }; // error: Cannot assign to `p`; a closure captures its value, not its binding
    f();
}
run(1);

// @split
fn run(k) {
    match (k) {
        v => { say f = () => { v = 2; return 1; }; f(); }, // error: Cannot assign to `v`; a closure captures its value, not its binding
    }
}
run(1);

// @split
fn run() {
    say b = Ref(1);
    say f = () => { @b = 2; return 1; };
    f();
    print(@b); // expect: 2
}
run();

// @split
say field = 0;
type T {
    var field = 1;
    pub fn bump(&var this) { this.field = this.field + 5; }
    pub fn read(this) { return this.field; }
}
say var t = T();
&t.bump();
print(t.read()); // expect: 6
print(field); // expect: 0
