type W { } obligation taint { witness W; discharge to use; }
fn nullable(x: opt) { return 1; }

fn make() { return { "d": W(), "n": null }; }
say bag = make();
print(nullable(bag["n"])); // expect: 1
try { print(nullable(bag["d"])); } catch (e) { print("witness caught"); } // expect: witness caught

// @split
fn v() { }
fn nullable(x: opt) { return 1; }

nullable(v()); // error: Argument 1 is a void result; the call returns no value
