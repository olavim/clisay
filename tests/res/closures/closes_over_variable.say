fn getClosure() {
    say x = Ref("foo");
    fn closure(arg): opt {
        fn get() {
            return @x;
        }
        fn set(val) {
            @x = val;
        }
        if arg == "get" {
            return get;
        } else if arg == "set" {
            return set;
        } else {
            return null;
        }
    }
    return closure;
}
say closure = getClosure();
print(closure("get")()); // expect: foo
closure("set")("foz");
print(closure("get")()); // expect: foz

// @split
// a closure holds the value, so the enclosing binding is untouched
fn getReader() {
    say var x = "foo";
    fn get() { return x; }
    x = "foz";
    return get;
}
print(getReader()()); // expect: foo
