// A jump into the middle of a fused run would land on the instruction that replaced the run, which
// consumes what the whole run did. A short-circuit branches exactly there.
say ok = false;
if (ok && 1 == 1) { print("A-ran"); }
print("done"); // expect: done

// @split
say ok = true;
if (ok && 1 == 1) { print("both"); } // expect: both
print("done"); // expect: done

// @split
say var n = 0;
say ok = false;
while (ok && n == 0) { n = n + 1; }
print(n); // expect: 0
