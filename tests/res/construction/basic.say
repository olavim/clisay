type Point { pub x; pub y; }
say p = Point { x: 1, y: 2 };
print(p.x); // expect: 1
print(p.y); // expect: 2
type Tagged {
    pub tag;
    pub count;
    init(this, c, t) { this.count = c; this.tag = t; }
}
say t = Tagged(5, "hi");
print(t.tag);   // expect: hi
print(t.count); // expect: 5
say x = 9;
say q = Point { x, y: 0 };
print(q.x); // expect: 9
