// Brace construction sets `pub` fields by name. With no init, all pub fields are brace-args.
type Point { pub x; pub y; }
say p = Point { x: 1, y: 2 };
print(p.x); // expect: 1
print(p.y); // expect: 2

// A factory call sets every field through init.
type Tagged {
    pub tag;
    pub count;
    init(c, t) { this.count = c; this.tag = t; }
}
say t = Tagged(5, "hi");
print(t.tag);   // expect: hi
print(t.count); // expect: 5

// Empty brace is allowed; shorthand `{ x }` means `{ x: x }`.
say x = 9;
say q = Point { x, y: 0 };
print(q.x); // expect: 9
