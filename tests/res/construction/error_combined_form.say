// A construction is a factory call or a brace, never both.
type T { pub x; pub y; init(this, a) { this.x = a; this.y = a; } }
say t = T(1) { y: 2 }; // error: cannot mix constructor arguments and brace fields; use `K(..)` or `K { .. }`

// @split
// An empty brace is still a brace, so an argument beside it has nowhere to go.
type E { init(this) {} }
say e = E(1) { }; // error: cannot mix constructor arguments and brace fields; use `K(..)` or `K { .. }`
