// Calling a method on the half-built `this` is illegal because `this` is not a value in a factory.
type T {
    pub mut value = 0;
    init() {
        this.setup(); // error: cannot access `this.setup` in a factory: `this` is not a value there, only its fields
    }
    fn setup() {
        this.value = 1;
    }
}
