fn f() {
    type P { pub a; pub b; pub fn m(this)! { return 1; } }
    say q = P { a: 8, b: 9 };
    print(q.a); // expect: 8
    print(q.b); // expect: 9
}
fn g() {
    type P { pub a; pub b; }
    say p = P { a: 1, b: 2 };
    print(p.a); // expect: 1
    print(p.b); // expect: 2
}
f();
g();

// @split
fn f() { type Q { pub a; pub extra; } say r = Q { a: 1, extra: 2 }; print(r.extra); }
fn g() { type Q { pub a; } say s = Q { a: 1, extra: 2 }; } // error: 'Q' has no field 'extra'
