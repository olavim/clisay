fn head(xs) {
  say [a, ..rest] = xs else { return "empty"; };
  return a + rest.length();
}
print(head([1, 2, 3])); // expect: 3
print(head([])); // expect: empty

fn first(xs) {
  say [a] = xs else { throw "not one"; };
  return a;
}
print(first([7])); // expect: 7

// @split
type Point { pub x; pub y; init(this, *x, *y) { this.x = x; this.y = y; } }
say p = Point(4, 5);
say Point { x, y } = p;
print(x + y); // expect: 9
