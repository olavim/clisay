type W { pub d; init(this, d) { this.d = d; } }
obligation warned { witness W; discharge to use; }
fn pick(i)!: warned { return W(i); }
fn f() {
    say var a = () => -1;
    say var b = () => -1;
    say var i = 0;
    while (i < 2) {
        say g = pick(i) ?? e => (() => e.d);
        if (i == 0) { a = g; }
        if (i == 1) { b = g; }
        i = i + 1;
    }
    print(a()); // expect: 0
    print(b()); // expect: 1
}
f();

// @split
fn f() {
    say var a = () => -1;
    say var b = () => -1;
    say var i = 0;
    while (i < 2) {
        say x = i;
        if (i == 0) { a = () => x; }
        if (i == 1) { b = () => x; }
        i = i + 1;
    }
    print(a()); // expect: 0
    print(b()); // expect: 1
}
f();

// @split
type W { pub d; init(this, d) { this.d = d; } }
obligation warned { witness W; discharge to use; }
fn f(x: warned)! { return x ?? e => (() => e.d); }
say g = f(W(7));
print(g()); // expect: 7
