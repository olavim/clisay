// An alternative that rules the witness out answered nothing, so an or-matcher whose alternatives
// all rule out has asked nothing. Widening a test must never settle more than the narrow one did.
trait Wt { }
obligation warned { witness Wt; discharge before drop; }
type W2 with Wt { }
type A { }
type B { }
fn f() {
    say b: warned = W2 { }; // error: 'b' owes 'warned' and is never discharged
    if (b ~ A | B) { print("or"); }
}
f();

// @split
// One alternative asking is enough, and the others may rule out.
trait Wt { }
obligation warned { witness Wt; discharge before drop; }
type W2 with Wt { }
type A { }
fn f() {
    say b: warned = W2 { };
    if (b ~ A | W2) { print("or"); }
}
f(); // expect: or
