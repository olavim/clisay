trait Wt { }
obligation warned { witness Wt; must use; }
type W2 with Wt { }
type Other { }
fn f() {
    say b: warned = W2 { };
    if (b ~ n @ Other) { say z = b; print("disjoint"); }
    else { print(b ?? "handled"); }
}
f(); // expect: handled

// @split
trait Wt { }
obligation warned { witness Wt; must use; }
type W2 with Wt { }
fn f() {
    say b: warned = W2 { };
    if (b ~ seen @ W2) { print(seen ?? "handled"); }
}
f(); // expect: handled

// @split
fn f(x?) {
    if (x ~ n @ null) { print("null"); }
    else { print(x + 1); }
}
f(1); // expect: 2
f(null); // expect: null
