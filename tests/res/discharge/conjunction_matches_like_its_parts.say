trait Wt { }
obligation warned { witness Wt; must use; }
type W2 with Wt { }
type Other { }
fn f() {
    say b: warned = W2 { };
    if (b ~ Other & W2) { say z = b; print("both"); }
    else { print(b ?? "handled"); }
}
f(); // expect: handled

// @split
type Wt { pub a; pub b; init(this, *x) { this.a = x; this.b = x; } }
obligation warned { witness Wt; must use; }
fn f() {
    say v: warned = Wt(1);
    if (v ~ Wt { a: p } & Wt { b: q }) { print(p + q); }
    else { say z = v; print("clean"); }
}
f(); // expect: 2
