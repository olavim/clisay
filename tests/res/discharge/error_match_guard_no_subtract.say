fn get(flag): opt {
    if (flag == 1) { return null; }
    if (flag == 2) { return Err("boom"); }
    return 10;
}
fn run(cond) {
    match get(3) {
        null if cond => print("null"),
        Err { value: e } => print(e),
        v => print(v + 5), // error: unchecked value owes 'opt'
    }
}
run(false);
