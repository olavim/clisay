// A `return Err` inside a match arm makes the function fail, so `!` on its result aborts and catches.
fn load(n)! {
    match n {
        0 => { return Err("boom"); },
        _ => { return 1; },
    }
}
try {
    load(0)!;
    print("unreachable");
} catch (e) {
    print("caught"); // expect: caught
}
