trait Wt { }
obligation warned { witness Wt; must use; }
type W2 with Wt { }
fn f() {
    say b: warned = W2 { };
    if (b ~ W2) { print("operator"); } // expect: operator
}
f();

// @split
trait Wt { }
obligation warned { witness Wt; must use; }
type W2 with Wt { }
fn f() {
    say b: warned = W2 { };
    match (b) { W2 => print("match"), _ => print("other"), } // expect: match
}
f();

// @split
trait Wt { }
obligation warned { witness Wt; must use; }
type W2 with Wt { }
fn f(flag) {
    say b: warned = W2 { };
    match (b) { W2 if flag => print("match"), _ => print("other"), }
}
f(false); // expect: other
