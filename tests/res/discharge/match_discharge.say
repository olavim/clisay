// A match over an obligated scrutinee rules out each witness. A binder after the null and Err
// arms is clean, so it can be used.
fn get(flag)? {
    if (flag == 1) { return null; }
    if (flag == 2) { return Err("boom"); }
    return 10;
}
fn run(flag) {
    match get(flag) {
        null => print("null"),
        is Err { value: e } => print(e),
        v => print(v + 5),
    }
}
run(1); // expect: null
run(2); // expect: boom
run(3); // expect: 15
