fn get(flag): opt {
    if (flag == 1) { return null; }
    if (flag == 2) { return Err("boom"); }
    return 10;
}
fn run(flag) {
    match get(flag) {
        null if true => print("null"),
        Err { value: e } => print(e),
        v => print(v + 5),
    }
}
run(1); // expect: null
run(2); // expect: boom
run(3); // expect: 15
