type W { secret; pub a; init(this) { this.secret = 1; this.a = 2; } }
obligation warned { witness W; must use; }
fn f() {
    say v: warned = W();
    if (v ~ { secret: _ }) { say z = v; print("shape"); }
    else { print(v ?? "handled"); }
}
f(); // expect: handled

// @split
type W { secret; pub a; init(this) { this.secret = 1; this.a = 2; } }
obligation warned { witness W; must use; }
fn f() {
    say v: warned = W();
    if (v ~ W { secret: s }) { print(s); } else { print("no match"); }
}
f(); // expect: no match
