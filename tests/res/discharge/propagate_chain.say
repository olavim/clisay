// `?!` over a `?` chain propagates the chain's whole set.
type Box { pub field; }
fn readConfig(flag)! {
    if (flag) { return Err("boom"); }
    return Box { field: "ok" };
}
fn loadField(flag)! {
    return readConfig(flag)?.field?!;
}
say clean = loadField(false) ?? "fallback";
print(clean); // expect: ok
say caught = loadField(true) ?? "fallback";
print(caught); // expect: fallback
