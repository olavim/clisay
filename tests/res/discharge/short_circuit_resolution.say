fn f(): fails { return Err("e"); }
say x: fails = f();
say ok = true;
if (ok || (x ?? 0) == 0) { print("a"); } // expect: a

// @split
fn f(): fails { return Err("e"); }
say x: fails = f();
if (true && !(x ~ Err)) { print("in"); }
print("end"); // expect: end

// @split
fn f(): fails { return Err("e"); }
say x: fails = f();
if (false || !(x ~ Err)) { print("in"); }
print("end"); // expect: end

// @split
fn f(): fails { return Err("e"); }
say x: fails = f();
if (x == 5 || !(x ~ Err)) { say y = x; print("clean"); }
print("end"); // expect: end

// @split
fn fail(): fails { return Err("boom"); }
fn f(k) { say x: fails = fail(); match (k) { 1 => { if (x != 5) { return; } }, _ => { x ?? 0; }, } print("end"); }
f(2); // expect: end

// @split
fn fail(): fails { return Err("boom"); }
fn f(k) { say x: fails = fail(); match (k) { _ => { x ?? 0; }, 1 => { if (x != 5) { return; } }, } print("end"); }
f(2); // expect: end

// @split
trait Wt { }
obligation warned { witness Wt; must use; }
type W2 with Wt { }
fn f() { say b: warned = W2 { }; if (b ~ null | W2) { print("or"); } }
f(); // expect: or
