// A built-in name is reserved in every scope, so a nested one cannot take it either.

fn f() { type Err { x; } }

// error(full):
// error: 'Err' is a built-in and cannot be redeclared
//  --> builtin_names_reserved.say:3:10
//   |
// 3 | fn f() { type Err { x; } }
//   |          ^^^^^^^^^^^^^^^

// @split
fn f() { say print = 1; }

// error(full):
// error: 'print' is a built-in and cannot be redeclared
//  --> builtin_names_reserved.say:1:10
//   |
// 1 | fn f() { say print = 1; }
//   |          ^^^^^^^^^^^^^^

// @split
fn f() { fn gcCollect()! { return 1; } }

// error(full):
// error: 'gcCollect' is a built-in and cannot be redeclared
//  --> builtin_names_reserved.say:1:10
//   |
// 1 | fn f() { fn gcCollect()! { return 1; } }
//   |          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

// @split
fn f(time) { }

// error(full):
// error: 'time' is a built-in and cannot be redeclared
//  --> builtin_names_reserved.say:1:6
//   |
// 1 | fn f(time) { }
//   |      ^^^^

// @split
fn g() { fn gcCollect(x) {} }

// error(full):
// error: 'gcCollect' is a built-in and cannot be redeclared
//  --> builtin_names_reserved.say:1:10
//   |
// 1 | fn g() { fn gcCollect(x) {} }
//   |          ^^^^^^^^^^^^^^^^^^
