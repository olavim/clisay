// A running frame's closure is on the stack for nothing to find, so the collector has to mark the
// frames. Freed, its block is recycled and the trace names whichever closure landed there.
type T {
    pub n;
    init(this) { this.n = 1; }
    pub fn inner(this)! { return 1; }
    pub fn outer(this)! { this.inner(); throw "x"; }
}
say t = T();
gcStress(true);
t.outer();

// error(full):
// error: Uncaught exception: "x"
//  --> frame_closure_rooted.say:7:41
//   |
// 6 |     pub fn inner(this)! { return 1; }
// 7 |     pub fn outer(this)! { this.inner(); throw "x"; }
//   |                                         ^^^^^^^^^^
// 	at T.outer (frame_closure_rooted.say:7)
// 	at script (frame_closure_rooted.say:11)
