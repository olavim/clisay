type T {
    pub value;
    init() {
        this.value = 1;
        this.value = 2;
    }
}
T();
// error(full):
// error: Immutable field `T.value` is initialized more than once
//  --> help_field_double_init.say:5:9
//   |
// 3 |     init() {
// 4 |         this.value = 1;
//   |         ^^^^^^^^^^ first initialized here
// 5 |         this.value = 2;
//   |         ^^^^^^^^^^ and a second time here
//   |
//   = help: keep only one, or make `T.value` mutable by declaring it as `pub mut value;`
