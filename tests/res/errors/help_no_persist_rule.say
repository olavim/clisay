obligation borrowed { no persist; no return; }
type Sink { pub mut item; init(this) { this.item = 0; } }
fn stash(x: borrowed) {
    say s = mut Sink();
    s.item = x;
}
// error(full):
// error: cannot store value owing 'borrowed' in a field
//  --> help_no_persist_rule.say:5:14
