fn f(x) {
    x = 2;
}
f(1);
// error(full):
// error: Cannot reassign binding `x`
//  --> help_reassign_parameter.say:2:5
//   |
// 1 | fn f(x) {
// 2 |     x = 2;
//   |     ^
//   = help: you can make `x` reassignable by declaring the parameter as `var x`

// @split
fn f(var x) {
    x = 2;
    print(x);
}
f(1); // expect: 2
