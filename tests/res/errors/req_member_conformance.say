// @split
trait Clearer {
    req var field : opt;
    pub fn clear(mut this) { this.field = null; }
}

type Box with Clearer {
    pub var field;
    init(this, *field) { this.field = field; }
}

// error(full):
// error: member `field` does not satisfy `Clearer.field`
//  --> req_member_conformance.say:7:5
//   |
// 1 | trait Clearer {
// 2 |     req var field : opt;
//   |         --------------- `Clearer` writes 'opt' into `field`
// ...
// 6 | type Box with Clearer {
// 7 |     pub var field;
//   |     ^^^^^^^^^^^^^^ `Box.field` does not owe 'opt'
//   |
//   = help: declare `field: opt` on `Box`

// @split
trait Reader {
    req data : opt;
}

type Box with Reader {
    pub fn data(this)! { return 5; }
    init(this) {}
}

