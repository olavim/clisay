trait Counter {
    req var count;
}

type Box with Counter {
    pub count;
    init(this, *count) { this.count = count; }
}

// error(full):
// error: member `count` does not satisfy `Counter.count`
//  --> req_member_conformance.say:6:5
//   |
// 1 | trait Counter {
// 2 |     req var count;
//   |         --------- `Counter` requires a reassignable `count`
// ...
// 5 | type Box with Counter {
// 6 |     pub count;
//   |     ^^^^^^^^^^ `Box.count` is not reassignable
//   |
//   = help: declare it `pub var count` on `Box`

