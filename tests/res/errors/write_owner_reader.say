// A reader takes the blame at its own write, while the capture caret names the binding the
// closure actually writes.
say a = mut {};
say f = () => { a["k"] = 9; };
say b = a;
print(b["k"]);
b["k"] = 2;
// error(full):
// error: cannot mutate a value whose write-ownership moved to a closure
//  --> write_owner_reader.say:7:1
//   |
// 3 | say a = mut {};
// 4 | say f = () => { a["k"] = 9; };
//   |                 ^ `a` is written here, which takes write-ownership
// ...
// 7 | b["k"] = 2;
//   | ^ `b` is mutated here
//   |
//   = help: a value has one write-owner; reading `b` is still fine, but to write it here, pass it to a `mut` function parameter instead of capturing it, or `copy` it into the closure
