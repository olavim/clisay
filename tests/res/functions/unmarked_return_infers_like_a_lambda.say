fn f() { return 1; }
say g = () => { return 1; };
print(f()); // expect: 1
print(g()); // expect: 1

// @split
fn nothing() { print("ran"); }
fn f() { return nothing(); }
say g = () => { return nothing(); };
g(); // expect: ran
f(); // expect: ran

// @split
fn nothing() { print("ran"); }
fn f() { return nothing(); }
print(f()); // error: Argument 1 is a void result; the call returns no value

// @split
fn nothing() { print("ran"); }
say g = () => { return nothing(); };
print(g()); // error: Argument 1 is a void result; the call returns no value

// @split
fn nothing() { print("ran"); }
fn f(c) { if (c) { return nothing(); } return 1; } // error: 'f' returns a value on some paths and no value on others
print(f(false));

// @split
fn nothing() { print("ran"); }
fn f(c) { if (c) { return nothing(); } return nothing(); }
f(false); // expect: ran
