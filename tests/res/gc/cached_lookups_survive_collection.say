// The index cache keys on a raw string pointer, which a sweep can free and the next intern reuse,
// so a forced collection between lookups must not let an entry answer for another name.
gcStress(true);
type A { pub alpha; pub beta; init(this) { this.alpha = 1; this.beta = 2; } }
type B { pub alpha; pub gamma; init(this) { this.alpha = 10; this.gamma = 20; } }
fn spin(n)! {
    say mut total = 0;
    say mut i = 0;
    while (i < n) {
        say a = A();
        say b = B();
        total = total + a.alpha + a.beta + b.alpha + b.gamma;
        i = i + 1;
    }
    return total;
}
print(spin(40)); // expect: 1320
