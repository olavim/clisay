gcStress(false);
type Node {
    pub next: opt;
    init(this, n: opt) {
        this.next = n;
    }
}
say var head: opt = null;
say var i = 0;
while i < 50000 {
    head = Node(head);
    i = i + 1;
}
gcCollect();
say var count = 0;
say var cur: opt = head;
while cur != null {
    count = count + 1;
    cur = cur.next;
}
print(count); // expect: 50000
