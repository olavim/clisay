// An object can grow after it is allocated, so live bytes are counted fresh at each collection.
// Subtracting what an object reported on the way out counted the growth it never added, which
// drifted and then underflowed.
say bytesStart = gcHeapSize();
{ say d = mut { }; d["a"] = 1; d["b"] = 2; d["c"] = 3; }
gcCollect();
print(gcHeapSize() - bytesStart); // expect: 0

// @split
// The drift accumulated across cycles, so many of them must still come back to nothing.
fn churn(n) {
    say mut i = 0;
    while (i < n) {
        say d = mut { };
        d["a"] = i;
        d["b"] = i;
        i = i + 1;
    }
}
say bytesStart = gcHeapSize();
churn(200);
gcCollect();
print(gcHeapSize() - bytesStart); // expect: 0

// @split
// Under `gcStress` every allocation collects, so the count is remade constantly while instances
// and dicts are built and read.
gcStress(true);
type A { pub alpha; pub beta; init(this) { this.alpha = 1; this.beta = 2; } }
type B { pub gamma; init(this) { this.gamma = 3; } }
fn spin(n)! {
    say mut total = 0;
    say mut i = 0;
    while (i < n) {
        say a = A();
        say b = B();
        say d = mut { };
        d["k"] = i;
        total = total + a.alpha + a.beta + b.gamma;
        i = i + 1;
    }
    return total;
}
print(spin(200)); // expect: 1200
