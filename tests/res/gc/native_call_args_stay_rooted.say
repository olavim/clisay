// Resolving a native method allocates a bound method, which can collect. The arguments have to
// stay on the value stack across it, or a freshly built one is freed and handed back dangling.
gcStress(true);
type T { pub a; init(this, v) { this.a = v; } }
say bag = mut [];
say var i = 0;
while (i < 30) { bag.push(T(i)); i = i + 1; }
print(bag[7].a);  // expect: 7
print(bag[29].a); // expect: 29
