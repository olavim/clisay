
say bytesStart = gcHeapSize();

{
    type Local {
        pub a;
        pub b;
        init(this) {
            this.a = "a";
            this.b = "b";
        }
        pub fn first(this) {
            return this.a;
        }
        pub fn second(this) {
            return this.b;
        }
    }
}

gcCollect();
print(gcHeapSize() - bytesStart); // expect: 0
