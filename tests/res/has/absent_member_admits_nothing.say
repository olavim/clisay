type Box { pub v?; }
say d = mut { };
print(d has Box); // expect: false
match (d) { has Box => print("yes"), _ => print("no"), } // expect: no

// @split
type Box { pub v?; }
say d = mut { "v": null };
print(d has Box); // expect: true
match (d) { has Box => print("yes"), _ => print("no"), } // expect: yes

// @split
type Box { pub v; }
say d = mut { "v": null };
print(d has Box); // expect: false
match (d) { has Box => print("yes"), _ => print("no"), } // expect: no

// @split
say e: fails = Err(null); // error: expected non-null argument
