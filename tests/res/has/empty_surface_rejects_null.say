// An empty surface asks for nothing beyond a shaped value, so a null does not have it.
trait Wt { }
type Empty { }
say d = mut { "a": 1 };
print(null has Wt); // expect: false
print(null has Empty); // expect: false
print(d has Wt); // expect: true
print(d has Empty); // expect: true

// @split
// The guard rules out null, so the branch may pass the value into a non-null slot.
trait Wt { }
fn take(v) { print("took"); }
fn f(x?) { if (x ~ has Wt) { take(x); } }
f(null);
print("end"); // expect: end

// @split
// The match spelling reads it the same way.
trait Wt { }
fn f(x?) { match (x) { has Wt => print("yes"), _ => print("no"), } }
f(null); // expect: no
