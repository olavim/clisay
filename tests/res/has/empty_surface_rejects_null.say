trait Wt { }
type Empty { }
say d = mut { "a": 1 };
print(null has Wt); // expect: false
print(null has Empty); // expect: false
print(d has Wt); // expect: true
print(d has Empty); // expect: true

// @split
trait Wt { }
fn take(v) { print("took"); }
fn f(x?) { if (x ~ has Wt) { take(x); } }
f(null);
print("end"); // expect: end

// @split
trait Wt { }
fn f(x?) { match (x) { has Wt => print("yes"), _ => print("no"), } }
f(null); // expect: no
