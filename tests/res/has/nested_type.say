// In a matcher a bare uppercase name is a nominal type test; `has T` is the structural test.
type Shape { pub a; init() { this.a = 1; } }

say s = Shape();
say d = { nested: s };
print(d has { nested: Shape }); // expect: true
print(d has { nested: has Shape }); // expect: true

say e = { nested: { a: 1 } };
print(e has { nested: Shape }); // expect: false
print(e has { nested: has Shape }); // expect: true
