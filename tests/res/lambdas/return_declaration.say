say nonNull = () => 1;
print(nonNull()); // expect: 1
say nullable = (n): opt => null;
print(nullable(1)); // expect: null
say owing = (): fails => Err("boom");
say r: fails = owing();
print(r ?? "recovered"); // expect: recovered
say mutable = () => [1];
say var a = mutable();
a[0] = 9;
print(a[0]); // expect: 9
say inferred = (v) => v;
print(inferred(5)); // expect: 5
say bare = (): opt => { return; };
print(bare() ?? "null"); // expect: null

// @split
say bad = (): fails => { return; }; // error: This 'return' returns null, which the declared return does not admit
