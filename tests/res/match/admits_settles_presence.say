// Admitting a member means finding it, so a surface test settles a shape key on the same name and
// the shape arm needs no second presence check.
type T { pub x; init(this, a) { this.x = a; } }
say t = T(1);
match t { has T => print("surface"), { x } => print("shape"), _ => print("none") } // expect: surface

// @split
type T { pub x; init(this, a) { this.x = a; } }
say t = T(1);
match t { { x } => print("shape"), has T => print("surface"), _ => print("none") } // expect: shape

// @split
// A value that has the member but does not admit it takes neither typed arm.
type T { pub x; init(this, a) { this.x = a; } }
say d = mut { "x": null };
match d { has T => print("surface"), _ => print("none") } // expect: none
