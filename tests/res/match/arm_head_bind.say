// A match arm head binds a lone lowercase name and tests an uppercase name, fieldless or shaped.
type Empty { init(this) { } }
type Point { pub x; init(this, *a) { this.x = a; } }

fn classify(v) {
    match v {
        Empty => print("empty"),
        Point { x } => print(x),
        v => print(v),
    }
}

classify(Empty()); // expect: empty
classify(Point(9)); // expect: 9
classify("other"); // expect: other
