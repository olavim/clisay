type P { pub x; init(this, a) { this.x = a; } }
fn t(v: opt) {
    match v {
        {} => print("dict"),
        _ => print("not"),
    }
}
t({}); // expect: dict
t({ a: 1 }); // expect: dict
t(P(1)); // expect: not
t(5); // expect: not
t("s"); // expect: not
t(null); // expect: not
t([1, 2]); // expect: not

// @split
type P { pub x; init(this, a) { this.x = a; } }
fn t(v: opt) {
    match v {
        has {} => print("shaped"),
        _ => print("not"),
    }
}
t({}); // expect: shaped
t(P(1)); // expect: shaped
t([1, 2]); // expect: not
