// An empty shape compiles to a single IS_SHAPED test.
say v = { a: 1 };
match v {
    {} => 0,
    _ => 0,
}
// expect asm:
// 0: PUSH_CONSTANT "a"
// 2: PUSH_CONSTANT 1
// 4: DICT <1> <1>
// 7: STORE_LOCAL L0
// 9: LOAD_LOCAL L0
// 11: LOAD_LOCAL L1
// 13: IS_SHAPED
// 14: JUMP_IF_FALSE <20>
// 17: JUMP <23>
// 20: JUMP <29>
// 23: PUSH_CONSTANT 0
// 25: POP
// 26: JUMP <35>
// 29: PUSH_CONSTANT 0
// 31: POP
// 32: JUMP <35>
// 35: POP
// 36: POP
// 37: PUSH_NULL
// 38: HALT
