// A literal field value rejects an absent key on its own, so no HAS_MEMBER presence test precedes
// it: the load and compare alone stand in for both presence and equality.
say v = { k: 5 };
match v {
    { k: 5 } => 0,
    _ => 0,
}
// expect asm:
// 0: PUSH_CONSTANT "k"
// 2: PUSH_CONSTANT 5
// 4: DICT <1> <1>
// 7: STORE_LOCAL L0
// 9: LOAD_LOCAL L0
// 11: LOAD_LOCAL L1
// 13: GET_INDEX_OR_NULL "k"
// 15: PUSH_CONSTANT 5
// 17: JUMP_IF_NEQ <23>
// 20: JUMP <26>
// 23: JUMP <32>
// 26: PUSH_CONSTANT 0
// 28: POP
// 29: JUMP <38>
// 32: PUSH_CONSTANT 0
// 34: POP
// 35: JUMP <38>
// 38: POP_SCOPE <1> <2>
// 41: POP_SCOPE <1> <1>
// 44: PUSH_NULL
// 45: HALT
