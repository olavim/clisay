// A nested field value that reads itself more than once is loaded once and reused, not re-walked:
// GET_INDEX_OR_NULL "a" appears a single time (offset 22), then DUP feeds the b and c tests.
say v = { a: { b: 1, c: 2 } };
match v {
    { a: { b, c } } => 0,
    _ => 0,
}
// expect asm:
// 0: PUSH_CONSTANT "a"
// 2: PUSH_CONSTANT "b"
// 4: PUSH_CONSTANT 1
// 6: PUSH_CONSTANT "c"
// 8: PUSH_CONSTANT 2
// 10: DICT <2> <1>
// 13: DICT <1> <1>
// 16: STORE_LOCAL L0
// 18: LOAD_LOCAL L0
// 20: PUSH_NULL
// 21: PUSH_NULL
// 22: LOAD_LOCAL L1
// 24: GET_INDEX_OR_NULL "a"
// 26: DUP
// 27: DUP
// 28: GET_INDEX_OR_NULL "b"
// 30: STORE_LOCAL_POP L2
// 32: HAS_MEMBER "b"
// 34: JUMP_IF_FALSE <47>
// 37: DUP
// 38: GET_INDEX_OR_NULL "c"
// 40: STORE_LOCAL_POP L3
// 42: HAS_MEMBER "c"
// 44: JUMP <49>
// 47: POP
// 48: PUSH_FALSE
// 49: JUMP_IF_FALSE <55>
// 52: JUMP <58>
// 55: JUMP <64>
// 58: PUSH_CONSTANT 0
// 60: POP
// 61: JUMP <70>
// 64: PUSH_CONSTANT 0
// 66: POP
// 67: JUMP <70>
// 70: POP_SCOPE <3> <4>
// 73: POP_SCOPE <1> <1>
// 76: PUSH_NULL
// 77: HALT
