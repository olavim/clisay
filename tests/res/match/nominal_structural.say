type Move { pub from; pub to; init(this, a, b) { this.from = a; this.to = b; } }
trait Logger { pub fn log(this) { } }
type Console with Logger { init(this) { } pub fn log(this) { print("logged"); } }
fn handle(event) {
    match event {
        Move { from: { x, y }, to } => { print(x); print(y); print(to); },
        { handler: Logger } => print("has logger"),
        _ => print("none"),
    }
}
handle(Move({ x: 1, y: 2 }, 9)); // expect: 1
// expect: 2
// expect: 9
handle({ handler: Console() }); // expect: has logger
handle(0); // expect: none
