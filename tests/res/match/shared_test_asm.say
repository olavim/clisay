// The decision tree emits each shared presence test once, not once per arm.
say obj = { a: 1, b: 2, c: 3 };
match obj {
    { a, b, c } => 0,
    { a, b } => 0,
    { a } => 0,
}
// expect asm:
// 0: PUSH_CONSTANT "a"
// 2: PUSH_CONSTANT 1
// 4: PUSH_CONSTANT "b"
// 6: PUSH_CONSTANT 2
// 8: PUSH_CONSTANT "c"
// 10: PUSH_CONSTANT 3
// 12: DICT <3> <1>
// 15: STORE_LOCAL L0
// 17: LOAD_LOCAL L0
// 19: PUSH_NULL
// 20: PUSH_NULL
// 21: PUSH_NULL
// 22: LOAD_LOCAL L1
// 24: HAS_MEMBER "a"
// 26: JUMP_IF_FALSE <88>
// 29: LOAD_LOCAL L1
// 31: HAS_MEMBER "b"
// 33: JUMP_IF_FALSE <79>
// 36: LOAD_LOCAL L1
// 38: HAS_MEMBER "c"
// 40: JUMP_IF_FALSE <64>
// 43: LOAD_LOCAL L1
// 45: GET_INDEX_OR_NULL "a"
// 47: STORE_LOCAL_POP L2
// 49: LOAD_LOCAL L1
// 51: GET_INDEX_OR_NULL "b"
// 53: STORE_LOCAL_POP L3
// 55: LOAD_LOCAL L1
// 57: GET_INDEX_OR_NULL "c"
// 59: STORE_LOCAL_POP L4
// 61: JUMP <91>
// 64: LOAD_LOCAL L1
// 66: GET_INDEX_OR_NULL "a"
// 68: STORE_LOCAL_POP L2
// 70: LOAD_LOCAL L1
// 72: GET_INDEX_OR_NULL "b"
// 74: STORE_LOCAL_POP L3
// 76: JUMP <97>
// 79: LOAD_LOCAL L1
// 81: GET_INDEX_OR_NULL "a"
// 83: STORE_LOCAL_POP L2
// 85: JUMP <103>
// 88: JUMP <109>
// 91: PUSH_CONSTANT 0
// 93: POP
// 94: JUMP <109>
// 97: PUSH_CONSTANT 0
// 99: POP
// 100: JUMP <109>
// 103: PUSH_CONSTANT 0
// 105: POP
// 106: JUMP <109>
