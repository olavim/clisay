// A shape key and a surface member with the same name are one presence test, so the `{ x }` binder
// and `has T` share the `x` check.
type T { pub x; init(a) { this.x = a; } }
say t = T(1);
match t {
    { x } => 0,
    has T => 0,
}
// expect asm:
// 0: PUSH_NULL
// 1: JUMP <20>
// 4: LOAD_LOCAL L2
// 6: LOAD_LOCAL L1
// 8: STORE_LOCAL_POP L2
// 10: LOAD_LOCAL L2
// 12: LOAD_LOCAL L0
// 14: SET_FIELD_POP <0>
// 16: POP
// 17: LOAD_LOCAL L0
// 19: RETURN_FAC
// 20: PUSH_TYPE <type T>
// 22: STORE_LOCAL L0
// 24: POP
// 25: LOAD_LOCAL L0
// 27: PUSH_CONSTANT 1
// 29: CALL <1>
// 31: STORE_LOCAL L1
// 33: LOAD_LOCAL L1
// 35: PUSH_NULL
// 36: LOAD_LOCAL L2
// 38: HAS_MEMBER "x"
// 40: JUMP_IF_FALSE <52>
// 43: LOAD_LOCAL L2
// 45: GET_INDEX_OR_NULL "x"
// 47: STORE_LOCAL_POP L3
// 49: JUMP <55>
// 52: JUMP <67>
// 55: PUSH_CONSTANT 0
// 57: POP
// 58: JUMP <67>
// 61: PUSH_CONSTANT 0
