// A shape key and a surface member with the same name are one presence test, so the `{ x }` binder
// and `has T` share the `x` check.
type T { pub x; init(a) { this.x = a; } }
say t = T(1);
match t {
    { x } => 0,
    has T => 0,
}
// expect asm:
// 0: PUSH_NULL
// 1: JUMP <13>
// 4: LOAD_LOCAL L1
// 6: LOAD_LOCAL L0
// 8: SET_FIELD_POP <0>
// 10: LOAD_LOCAL L0
// 12: RETURN
// 13: PUSH_TYPE <type T>
// 15: STORE_LOCAL L0
// 17: POP
// 18: LOAD_LOCAL L0
// 20: PUSH_CONSTANT 1
// 22: CALL <1>
// 24: DEEP_SEAL
// 25: STORE_LOCAL L1
// 27: LOAD_LOCAL L1
// 29: PUSH_NULL
// 30: LOAD_LOCAL L2
// 32: HAS_MEMBER "x"
// 34: JUMP_IF_FALSE <46>
// 37: LOAD_LOCAL L2
// 39: GET_INDEX_OR_NULL "x"
// 41: STORE_LOCAL_POP L3
// 43: JUMP <49>
// 46: JUMP <61>
// 49: PUSH_CONSTANT 0
// 51: POP
// 52: JUMP <61>
// 55: PUSH_CONSTANT 0
// 57: POP
// 58: JUMP <61>
// 61: POP
// 62: POP
// 63: POP
// 64: POP
// 65: PUSH_NULL
// 66: HALT
