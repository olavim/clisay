// A shape key tests presence, while a surface member of a declared type tests what the declaration
// admits. They are different tests on the same name, so the `{ x }` arm does not share with `has T`.
type T { pub x; init(this, *a) { this.x = a; } }
say t = T(1);
match t {
    { x } => 0,
    has T => 0,
}
