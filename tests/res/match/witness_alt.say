type Node { pub next; init(this, n) { this.next = n; } }
fn nullable(v: opt) {
    match v {
        Node { next } | null => print(next ?? 0),
        _ => print("no"),
    }
}
nullable(Node(5)); // expect: 5
nullable(null); // expect: 0
fn fallible(v) {
    match v {
        Node { next } | Err => print(next ?? -1),
        _ => print("no"),
    }
}
fallible(Node(7)); // expect: 7
