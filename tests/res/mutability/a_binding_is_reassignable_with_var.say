// `var` makes the binding reassignable. `mut` makes the value writable. The two are independent,
// so a binding may have either, both, or neither.
say var a = 1;
a = 2;
print(a); // expect: 2

// @split
say var b = mut [1];
b = mut [2];
b[0] = 3;
print(b[0]); // expect: 3

// @split
say c = mut [1];
c[0] = 9;
print(c[0]); // expect: 9

// @split
say var d = [1];
d = [2];
print(d[0]); // expect: 2

// @split
say e = 1;
e = 2; // error: Cannot reassign binding `e`
