say var m = mut [1, 2];
say e: fails = Err(m);
print(e ?? p => "caught"); // expect: caught
m[0] = 9; // error: cannot mutate an immutable value

// @split
type Box { pub v; init(this, *v) { this.v = v; } }
say var m = mut [1, 2];
say b = Box(m);
m[0] = 9; // error: cannot mutate an immutable value
