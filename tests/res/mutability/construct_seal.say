type T { pub x; }
say a = mut [mut [0]];
say t = T{ x: a[0] }; // error: cannot store a mutable value in an immutable container
a[0][0] = 1;

// @split
type T { pub x; }
say t = mut T{ x: mut [0] };
t.x[0] = 1;
print(t.x[0]); // expect: 1

// @split
type T { pub x; }
say a = mut [mut [0]];
say t = mut T{ x: a[0] };
t.x[0] = 1;
print(a[0][0]); // expect: 1

// @split
type U { pub y; }
type T { pub x; }
say a = mut [mut [0]];
say t = mut T{ x: U{ y: a[0] } }; // error: cannot store a mutable value in an immutable container

// @split
type T { pub x; }
say a = [[0]];
say t = T{ x: a[0] };
print(t.x[0]); // expect: 0

// @split
type T { pub x; init(this, *x) { this.x = x; } }
say a = mut [mut [0]];
say t = T(a[0]);
a[0][0] = 1; // error: cannot mutate an immutable value

// @split
type T { pub x; init(this, x) { this.x = 0; } }
say a = mut [mut [0]];
say t = T(a[0]);
a[0][0] = 1;
print(a[0][0]); // expect: 1

// @split
say a = mut [mut [0]];
freeze(a);
print(a[0][0]); // expect: 0
