// A native factory takes the seal from its call site like a script one, or `mut K(..)` hands back
// an immutable value while the checker reasons about a mutable one.
say e: fails = mut Err("x");
e ?? 0;
e["value"] = 5;
print(e["value"]); // expect: 5

// @split
// Without `mut` the construction is plain, and the value it hands back is immutable.
say e: fails = Err("x");
e ?? 0;
e["value"] = 5; // error: cannot mutate an immutable value
