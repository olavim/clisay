// A borrow lasts the call, and a closure that outlives the call retains what it captured. A write
// through the capture answers to the declaration first, so a read-only parameter refuses it before
// how long the closure lives comes up at all.
say var kept? = null;
fn f(x) { say cb = () => { x[0] = 5; return 1; }; kept = cb; } // error: cannot retain a borrowed argument
say m = mut [1];
f(m);

// @split
// The same refusal for a closure that only reads it.
say var kept? = null;
fn f(x) { say cb = () => x[0]; kept = cb; } // error: cannot retain a borrowed argument
say m = mut [1];
f(m);

// @split
// The signature is what is refused, not the argument, so an immutable one reads the same.
say var kept? = null;
fn f(x) { say cb = () => x[0]; kept = cb; } // error: cannot retain a borrowed argument
say m = [1];
f(m);

// @split
// `*` declares the retention, and the same body is then fine.
say var kept? = null;
fn f(*x) { say cb = () => x[0]; kept = cb; }
say m = [1];
f(m);
print(kept!()); // expect: 1

// @split
// A closure that dies with the call retains nothing, so it needs no marker.
fn f(x) { say cb = () => x[0]; print(cb()); } // expect: 1
say m = mut [1];
f(m);

// @split
// The declaration is what governs, so a `mut` parameter is written through a capture just as it is
// written directly.
fn f(x: mut) { say cb = () => { x[0] = 5; return x[0]; }; print(cb()); } // expect: 5
say m = mut [1];
f(m);

// @split
// A nested function that never leaves is the same case. It was refused until the escape summary
// stopped reading every nested capture as a persist.
fn f(x) { fn g() { print(x); } g(); }
f(1); // expect: 1

// @split
// One more arrow does not change the answer. A closure holds what a nested one captures, since it
// holds the nested one.
say var kept? = null;
fn f(x) { kept = () => () => x[0]; } // error: cannot retain a borrowed argument
say m = [1];
f(m);

// @split
// Three levels read the same.
say var kept? = null;
fn f(x) { kept = () => () => () => x[0]; } // error: cannot retain a borrowed argument
say m = [1];
f(m);

// @split
// `*` declares the retention at any depth.
say var kept? = null;
fn f(*x) { kept = () => () => x[0]; }
say m = [1];
f(m);
print(kept!()()); // expect: 1

// @split
// A nested closure that reads nothing of the caller's retains nothing.
say var kept? = null;
fn f(x) { print(x[0]); kept = () => () => 7; } // expect: 1
say m = [1];
f(m);
print(kept!()()); // expect: 7

// @split
// A closure that binds a name itself has not reached out for it, so sharing a spelling with the
// caller's parameter is not sharing its value.
say var kept? = null;
fn f(x) { kept = (x) => x[0]; }
f([1]);
print(kept!([7])); // expect: 7

// @split
// The same for a name the closure declares rather than takes, read from one nested inside it.
say var kept? = null;
fn f(q) { kept = () => { say q = [9]; return () => q[0]; }; }
f([1]);
print(kept!()()); // expect: 9

// @split
// A nested function reaching past itself is still the case the rule is for.
say var kept? = null;
fn f(g) { fn h(y) { return g[y]; } kept = h; } // error: cannot retain a borrowed argument
f([1]);

// @split
// A bare field name is an identifier like any other, so the rule asks where a name binds rather
// than matching the name alone. Both of these write the field, not the binding beside them.
say n = [1];
type T {
    pub var n;
    init(this) { this.n = mut [7]; }
    pub fn bump(this: mut) { n[0] = 5; print(n[0]); }
}
say t = mut T();
t.bump(); // expect: 5

// @split
// The same where the shadowed name is a read-only parameter rather than a global.
fn outer(n) {
    type T { pub var n; init(this) { this.n = mut [7]; } pub fn bump(this: mut) { n[0] = 5; print(n[0]); } }
    say t = mut T();
    t.bump();
}
outer([1]); // expect: 5
