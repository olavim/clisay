// A lent value keeps its lender's claim, and the lender is suspended for the call.
fn touch(mut x) { x[0] = 5; }
say a = mut [1];
a[0] = 6;
touch(a);
print(a[0]); // expect: 5

// @split
fn touch(mut x) { x[0] = 5; }
say a = mut [1];
touch(a);
a[0] = 6;
print(a[0]); // expect: 6

// @split
fn hand(mut x) { deeper(x); }
fn deeper(mut y) { y[0] = 5; }
say a = mut [1];
a[0] = 6;
hand(a);
print(a[0]); // expect: 5

// @split
// A container's claim is nobody's loan, so lending the element does not excuse the write.
fn touch(mut x) {
    x[0] = 9; // error: cannot write an element whose write-ownership moved to another container
}
say sink = mut [];
say a = mut [mut [0]];
sink.push(a[0]);
touch(a[0]);
