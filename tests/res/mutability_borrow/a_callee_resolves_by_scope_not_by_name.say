say sink = mut [];
fn borrows(x) { fn keep(v) { print(v[0]); } keep(x); }
fn retains() { fn keep(*v) { sink.push(v); } keep(mut [1]); }
retains();
say m = mut [3];
borrows(m); // expect: 3
print(sink[0][0]); // expect: 1

