// Closing an upvalue pops its slot, so a captured local is one of the values a scope gives back.
say a = mut [mut [0]];
say fns = mut [];
{ say c = mut []; c.push(a[0]); fns.push(() => c.length()); }
{ say d = a[0]; d[0] = 9; } // error: cannot write an element whose write-ownership moved to another container

// @split
// The same block without the capture, where the count was right all along.
say a = mut [mut [0]];
{ say c = mut []; c.push(a[0]); }
{ say d = a[0]; d[0] = 9; print(d[0]); } // expect: 9

// @split
// A scope that took no claim of its own is unaffected by one taken before it.
say a = mut [mut [0]];
{ say c = mut []; c.push(a[0]); }
{ say q = mut [1]; q[0] = 2; print(q[0]); } // expect: 2
