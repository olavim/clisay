fn f(mut x) { say a = mut [x]; }
say m = mut [1];
f(m);
print(m[0]); // expect: 1

// @split
fn f(x) { say a = mut [x]; }
say m = mut [1];
f(m);
print(m[0]); // expect: 1

// @split
fn f(mut x) { say a = mut [x]; a[0][0] = 5; }
say m = mut [1];
f(m);
print(m[0]); // expect: 5

// @split
fn f(mut x)! { say a = mut [x]; return a[0][0]; }
say m = mut [7];
print(f(m)); // expect: 7
