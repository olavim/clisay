// Forwarding an argument to a callee that returns it keeps nothing while the result is dropped.
fn inner(y)! { return y; }
fn outer(x) { inner(x); }
say a = mut [1, 2];
outer(a);
a[0] = 5;
print(a[0]); // expect: 5

// @split
// Binding what the forward hands back is what moves it out of the caller.
fn inner(y)! { return y; }
fn outer(x)! { return inner(x); }
say a = mut [1, 2];
say b = outer(a);
a[0] = 5; // error: cannot write `a`, which gave its write-ownership away
