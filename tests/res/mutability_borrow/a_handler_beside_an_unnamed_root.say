// An unnamed root leaves a live cell for its barrier. A nearby handler must
// include that cell when counting its own.
say sink = mut [mut [0, 0]];
fn get()! { return sink; }

get()[Err("k") ?? e => 0][0] = 5;
print(sink[0][0]); // expect: 5

// Storing through a named root creates no copy.
sink[Err("n") ?? e => 0][1] = 6;
print(sink[0][1]); // expect: 6

// @split
say sink = mut [mut [0, 0, 0, 0, 0]];
fn get()! { return sink; }
say other = mut [mut [0]];
fn go()! { return other; }

get()[0][(go()[0][0] = 3) + (Err("z") ?? e => 1)] = 8;
print(sink[0][4]);  // expect: 8
print(other[0][0]); // expect: 3
