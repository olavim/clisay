// A lambda has no `*` to declare a take with, so what its body keeps is what the call hands over.
// A value the caller made and nothing else names goes across.
say sink = mut [];
say k = (a) => { sink.push(a); return 1; };
print(k(mut [7])); // expect: 1
print(sink[0][0]); // expect: 7

// @split
// A borrow does not, and the call that hands one in is where it is refused.
say sink = mut [];
say k = (a) => { sink.push(a); return 1; };
fn f(x) { k(x); } // error: cannot pass a borrowed argument to a callee that retains it
say m = mut [1];
f(m);

// @split
// A parameter the body only reads is still borrowed, so the caller keeps writing it after the call.
say k = (a) => a[0];
say m = mut [1];
print(k(m)); // expect: 1
m[0] = 5;
print(m[0]); // expect: 5

// @split
// This is the `*` spelling's behaviour, which is what it is meant to match.
say sink = mut [];
fn g(*a) { sink.push(a); }
g(mut [7]);
print(sink[0][0]); // expect: 7
