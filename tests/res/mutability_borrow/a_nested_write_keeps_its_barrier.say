// A write nested inside another write's target is a write of its own. Only the dot path walked the
// target, so the bracket form never checked the inner write and let a second writer through.
say holder = mut [];
say outer = mut [mut [mut [0]]];
holder.push(outer[0]);
fn f()! { return outer[0]; }
(f()[0] = mut [9])[0] = 1; // error: cannot write an element whose write-ownership moved to another container

// @split
// The same write standing alone, which was refused all along.
say holder = mut [];
say outer = mut [mut [mut [0]]];
holder.push(outer[0]);
fn f()! { return outer[0]; }
f()[0] = mut [9]; // error: cannot write an element whose write-ownership moved to another container

// @split
// The dot form, which walked its target and kept the barrier.
say holder = mut [];
say outer = mut [mut [mut [0]]];
holder.push(outer[0]);
fn f()! { return outer[0]; }
(f()[0] = mut [9]).y = 1; // error: cannot write an element whose write-ownership moved to another container

// @split
// A legitimate nested write still runs, and the outer barrier still compares against its own root.
say sink = mut [mut [mut [mut [0]]]];
fn f()! { return sink; }
(f()[0] = mut [mut [0]])[0][0] = 9;
print(sink[0][0][0]); // expect: 9
