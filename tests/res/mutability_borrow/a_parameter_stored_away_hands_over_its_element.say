// A callee storing its argument into a container takes the element's writer slot, so the caller
// that handed it over stops writing it. The callee cannot see that the value is somebody's element,
// so it claims the slot at runtime and the claim decides.
say sink = mut [];
fn keeper(*v) { sink.push(v); }
say a = mut [mut [0]];
keeper(a[0]);
a[0][0] = 99; // error: cannot write an element whose write-ownership moved to another container
print(sink[0][0]);

// @split
// Reading through the container that took it is what the handover allows.
say sink = mut [];
fn keeper(*v) { sink.push(v); }
say a = mut [mut [0]];
keeper(a[0]);
print(sink[0][0]); // expect: 0

// @split
// A callee that hands its argument straight back stores nothing, so the caller keeps writing it.
fn peek(v)! { return v; }
say a = mut [mut [0]];
print(peek(a[0])[0]); // expect: 0
a[0][0] = 5;
print(a[0][0]); // expect: 5

// @split
// The container may be the callee's own parameter. Its slot dies with the call, but the container
// it named does not, so the claim it made stands.
fn keep(mut c, *v) { c.push(v); }
say s1 = mut [];
say a = mut [mut [0]];
keep(s1, a[0]);
a[0][0] = 99; // error: cannot write an element whose write-ownership moved to another container
print(s1[0][0]);

// @split
// Or a container the callee builds and returns, whose slot dies the same way.
fn wrap(*v)! { say box = mut []; box.push(v); return box; }
say a = mut [mut [0]];
say b = wrap(a[0]);
a[0][0] = 99; // error: cannot write an element whose write-ownership moved to another container
print(b[0][0]);

// @split
// The container that took it writes it, wherever it was built.
fn wrap(*v)! { say box = mut []; box.push(v); return box; }
say a = mut [mut [0]];
say b = wrap(a[0]);
b[0][0] = 9;
print(b[0][0]); // expect: 9

// @split
// A claim made for a container an enclosing frame names outlives the call that made it. Releasing
// it with the callee's own slots is what let the caller write the element again.
fn run() {
    say sink = mut [];
    fn keeper(*v) { sink.push(v); }
    say a = mut [mut [0]];
    keeper(a[0]);
    a[0][0] = 99; // error: cannot write an element whose write-ownership moved to another container
    print(sink[0][0]);
}
run();
