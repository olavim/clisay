fn take(*v)! { return v; }
type T {
    pub v;
    init(this) { this.v = 1; }
    pub fn m(this, cb) { cb(this); } // error: cannot pass a borrowed argument to a callee that retains it
}
say a = mut T();
a.m(take);

// @split
fn look(v)! { return v.v; }
type T {
    pub v;
    init(this) { this.v = 1; }
    pub fn m(this, cb)! { return cb(this); }
}
say a = mut T();
print(a.m(look)); // expect: 1
