// A mutating call carries its receiver's root whichever way the member was written.
say sink = mut [];
say a = mut [mut [0]];
sink.push(a[0]);
a[0]["push"](9); // error: cannot write an element whose write-ownership moved to another container

// @split
say sink = mut [];
say a = mut [mut [0]];
sink.push(a[0]);
a[0].push(9); // error: cannot write an element whose write-ownership moved to another container

// @split
say d = mut { a: 1 };
print(d.size()); // expect: 1
d["size"] = () => "data";
print(d["size"]()); // expect: data
print(d.size()); // expect: 2
print(d["containsKey"]); // expect: null
print(d.containsKey("a")); // expect: true
