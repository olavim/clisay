// A container built in a return has no binding for codegen to key a transfer to, so nothing was
// ever emitted here. The store itself records what holds the element.
fn wrap(x)! { return mut [x]; }
say a = mut [mut [0]];
say w = wrap(a[0]);
a[0][0] = 1; // error: cannot write an element whose write-ownership moved to another container

// @split
// The spelling that gives codegen a name answers the same, as it did before.
fn wrap(x)! { say c = mut [x]; return c; }
say a = mut [mut [0]];
say w = wrap(a[0]);
a[0][0] = 1; // error: cannot write an element whose write-ownership moved to another container

// @split
// The container that took the element still writes it.
fn wrap(x)! { return mut [x]; }
say a = mut [mut [0]];
say w = wrap(a[0]);
w[0][0] = 7;
print(w[0][0]); // expect: 7

// @split
// A container the callee drops holds nothing, so the element is writable again.
fn stash(v) { say c = mut []; c.push(v); }
say a = mut [mut [0]];
stash(a[0]);
a[0][0] = 8;
print(a[0][0]); // expect: 8

// @split
// A path writes freely through the container that holds its target, however deep the nesting is.
say a = mut [mut [mut [0]]];
a[0][0][0] = 4;
print(a[0][0][0]); // expect: 4

// @split
// A receiver writes its own fields wherever it lives. The path root is the receiver itself, so
// there is no container between it and the write to disagree with.
type Inner { pub var n; pub fn bump(this: mut) { this.n = this.n + 1; } }
type Outer { pub var i; }
say o = mut Outer { i: mut Inner { n: 0 } };
o.i.bump();
print(o.i.n); // expect: 1

// @split
// The same where the container is an array.
type Inner { pub var n; pub fn bump(this: mut) { this.n = this.n + 1; } }
say list = mut [];
list.push(mut Inner { n: 4 });
list[0].bump();
print(list[0].n); // expect: 5

// @split
// A target a call produced is the whole path, so nothing names the container it came through.
type Box { pub var items; pub fn get(this)! { return this.items; } }
say b = mut Box { items: mut [0] };
b.get()[0] = 9;
print(b.items[0]); // expect: 9

// @split
// The same through a dict and through an instance field.
say d = mut { k: mut [0] };
d["k"][0] = 5;
print(d["k"][0]); // expect: 5
type T { pub var x; }
say t = mut T { x: mut [0] };
t.x[0] = 6;
print(t.x[0]); // expect: 6
