// A caller that cannot name its callee lends every mutable argument. The callee's own move mask
// clears the lend for a parameter that takes, so the two paths refuse the same programs.
fn keep(mut bin, x) { bin.push(x); } // error: cannot retain a borrowed argument
fn f(g) {
    say bin = mut [];
    say m = mut [1];
    g(bin, m);
}
f(keep);

// @split
// The resolved call refuses the same program, which is the point of marking the opaque one.
fn keep(mut bin, x) { bin.push(x); } // error: cannot retain a borrowed argument
say bin = mut [];
say m = mut [1];
keep(bin, m);

// @split
// A parameter that takes its argument is not borrowing it, so the lend does not reach it.
fn take(mut bin, *x) { bin.push(x); }
fn f(g) {
    say bin = mut [];
    say m = mut [1];
    g(bin, m);
    print(bin[0][0]); // expect: 1
}
f(take);

// @split
// A borrow may not be handed on to a callee that takes, even an unnameable one.
fn take(*x) { print(x[0]); }
fn outer(g, mut y) { g(y); } // error: cannot pass a borrowed argument to a callee that retains it
say m = mut [1];
outer(take, m);

// @split
// The same bars a `no persist` value, which the survive barrier holds to independently.
obligation keeps { no persist; }
fn take(*x) { print(x); }
fn outer(g, v: keeps) { g(v); } // error: cannot pass a value owing 'keeps' to a callee that retains it
outer(take, 1);
