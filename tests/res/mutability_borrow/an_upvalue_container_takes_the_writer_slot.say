// A container holds the elements it is given even if the body reaches it as an upvalue.
fn run() {
    say sink = mut [];
    fn stash() {
        say a = mut [mut [0]];
        sink.push(a[0]);
        a[0][0] = 99; // error: cannot write an element whose write-ownership moved to another container
        print(sink[0][0]);
    }
    stash();
}
run();

// @split
// The same body with the container in its own frame, which worked all along.
fn run() {
    say sink = mut [];
    say a = mut [mut [0]];
    sink.push(a[0]);
    a[0][0] = 99; // error: cannot write an element whose write-ownership moved to another container
    print(sink[0][0]);
}
run();

// @split
// The container that took the element is the one that writes it, and reaching it as an upvalue
// does not make its own path somebody else's.
fn run() {
    say sink = mut [];
    fn stash() {
        say a = mut [mut [0]];
        sink.push(a[0]);
        sink[0][0] = 5;
        print(sink[0][0]); // expect: 5
    }
    stash();
}
run();

// @split
// A value that came out of no container is nobody's element, so pushing it through an upvalue
// hands over nothing and the container writes it freely.
fn run() {
    say sink = mut [];
    fn stash() { sink.push(mut [0]); }
    stash();
    print(sink.length()); // expect: 1
}
run();
