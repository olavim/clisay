// A factory that captures is installed as a closure, so the caller-side escape check has to read
// one. Handing it a mutable value is a consume, and the diagnostic belongs at the call.
fn pick(c)! { type Box { pub inner; pub tag; init(this, x) { this.inner = x; this.tag = c; } } return Box; }
say maker = pick(1);
say v = mut [1, 2];
say b = maker(v);
print(v[0]); // error: value used after a call consumed it
