// A parameter wrapped in a container literal and persisted escapes with the container. The callee
// is what breaks the rule, since it stores a value it only borrowed.
type Box { pub var item; init(this) { this.item = 0; } pub fn keep(this: mut, x) { this.item = [x]; } } // error: cannot persist a borrowed value
say b = mut Box();
say m = mut [1, 2];
b.keep(m);
