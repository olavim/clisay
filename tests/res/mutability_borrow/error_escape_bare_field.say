// A bare-name assignment may be a field store, so it persists conservatively.
type Sink { pub mut item; init() { this.item = 0; } pub fn keep(x) { item = x; } }
say s = Sink();
say m = mut [1, 2];
s.keep(m); // error: 'm' is mutable and this function keeps its argument; freeze or copy it, or take it by '*mut'
