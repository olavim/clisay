// A `this.method` call forwards to the resolved method, so the persist is caught in the body that
// does the storing.
type Sink { pub mut item; init(this) { this.item = 0; } pub fn keep(this: mut, x) { this.stash(x); } fn stash(this: mut, x) { this.item = x; } } // error: cannot persist a borrowed value
say s = mut Sink();
say m = mut [1, 2];
s.keep(m);
