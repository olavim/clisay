// Forwarding a borrow to an opaque callback is allowed, but persisting the parameter is not.
obligation borrowed { no persist; no return; }
type Box {
    pub var item;
    init(this) { this.item = 0; }
    fn stash(this: mut, x: borrowed, cb) { cb(x); this.item = x; } // error: cannot store value owing 'borrowed' in a field
}
