// A persist reached only through recursion still reaches the caller, so the group settles on it.
type Box { pub mut v; init(this) { this.v = 0; } }
fn keep(x: mut, sink: mut, n) { // error: a `mut` parameter borrows its argument and cannot let it escape
    if (n > 0) { keep(x, sink, n - 1); } else { sink.v = x; }
}
