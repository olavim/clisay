fn f(mut x) { throw mut { "k": x }; } // error: cannot retain a borrowed argument
say m = mut [1];
try { f(m); } catch (e) { print("caught"); }

// @split
fn f(mut x) { say a = mut []; a.push(x); throw a; } // error: cannot retain a borrowed argument
say m = mut [1];
try { f(m); } catch (e) { print("caught"); }

// @split
fn f(mut x) { throw mut [mut [mut [x]]]; } // error: cannot retain a borrowed argument
say m = mut [1];
try { f(m); } catch (e) { print("caught"); }

// @split
fn f(mut x) { say a = mut [x]; throw () => a[0][0]; } // error: cannot retain a borrowed argument
say m = mut [1];
try { f(m); } catch (e) { print("caught"); }

// @split
fn f(mut x) { say a = mut [1, x, 3]; if (a ~ [first, ..mid, last]) { throw mid; } } // error: cannot persist a borrowed value
say m = mut [9];
try { f(m); } catch (e) { print("caught"); }

// @split
fn f(mut x) { say a = mut [x, 2, 3]; if (a ~ [first, ..mid, last]) { throw mid; } }
say m = mut [9];
try { f(m); } catch (e) { print("caught"); } // expect: caught

// @split
fn keep(*x)! { return mut [x]; }
say m = mut [1];
say held = keep(m);
held[0][0] = 9;
print(held[0][0]); // expect: 9
