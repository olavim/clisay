// A recursive call is analyzed as a group, so a borrow that never leaves the group stays a borrow.
type Box { pub var v; init(this) { this.v = 1; } }

fn countDown(mut x, n)! { if (n > 0) { return countDown(x, n - 1); } return x.v; }

fn ping(mut x, n)! { if (n > 0) { return pong(x, n - 1); } return x.v; }
fn pong(mut x, n)! { return ping(x, n - 1); }

say b = mut Box();
print(countDown(b, 3)); // expect: 1
print(ping(b, 4));      // expect: 1
