say var kept? = null;
fn give(a) { kept = a; } // error: cannot retain a borrowed argument
give(mut [1]);

// @split
say var kept? = null;
fn give(a) { kept = a || a; } // error: cannot retain a borrowed argument
give(mut [1]);

// @split
say var kept? = null;
fn give(a) { kept = a && a; } // error: cannot retain a borrowed argument
give(mut [1]);

// @split
say var kept? = null;
fn give(a) { say var b? = null; kept = (b = a); } // error: cannot retain a borrowed argument
give(mut [1]);

// @split
fn pick(x?, y)! { return x || y; }
print(pick(null, 7)); // expect: 7

// @split
fn give(a)! { say var b? = null; b = a; return b![0]; }
say m = mut [3];
print(give(m)); // expect: 3
