// Capability sits ahead of the name over two independent axes. `mut` demands a value that may be
// written, `*` takes write-ownership instead of borrowing for the call.
fn borrowAny(x) { print(x[0]); }
fn borrowMut(mut x) { x[0] = 2; }
fn takeAny(*x) { print(x[0]); }
fn takeMut(*mut x) { x[0] = 9; print(x[0]); }
say a = mut [1];
borrowAny(a); // expect: 1
borrowMut(a);
print(a[0]); // expect: 2
say b = mut [5];
takeAny(b); // expect: 5
say c = mut [0];
takeMut(c); // expect: 9

// @split
// `*` asks nothing of the value, so an immutable one may be taken.
fn takeAny(*x) { print(x[0]); }
say a = [7];
takeAny(a); // expect: 7

// @split
// A taken value is gone from the caller, however it was taken.
fn takeAny(*x) { print(x[0]); }
say a = mut [1];
takeAny(a);
a[0] = 5; // error: cannot write `a`, which gave its write-ownership away

// @split
// A take owns what it was given, so it may persist it.
fn keep(*x)! { return x; }
say bin = mut [];
say a = mut [1];
bin.push(keep(a));
print(bin[0][0]); // expect: 1

// @split
// A borrow cannot be given away, so it may not feed a taking parameter.
fn take(*x) { print(x[0]); }
fn lend(mut y) { take(y); } // error: cannot move borrowed value `y`
say a = mut [1];
lend(a);

// @split
// `*mut` is the two facts together, and only the `mut` half demands anything of the value.
fn takeMut(*mut x) { x[0] = 1; }
say a = [1];
takeMut(a); // error: expected mutable argument
