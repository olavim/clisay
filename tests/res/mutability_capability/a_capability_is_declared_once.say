// A capability is spelled ahead of the name, and the ':' clause refuses one.
fn takes(*mut x) { x[0] = 1; }
say a = mut [0];
takes(a);
print("ran"); // expect: ran

// @split
fn old(x: *mut) { print(x[0]); } // error: A capability leads the name, not the ':' clause

// @split
fn recv(this: mut) { } // error: A capability leads the name, not the ':' clause

// @split
// A combinator has no one name for the marker to sit on, so it has to be grouped.
type Node { pub next?; init(this) { this.next = null; } }
fn f(*p @ Node | null) { } // error: A capability ahead of a combinator needs the pattern grouped

// @split
type Box { pub data; init(this, *d) { this.data = d; } }
fn peek(mut Box { data }) { data.push(2); }
fn named(mut Box) { }
say b = mut Box(mut [1]);
peek(b);
print(b.data[1]); // expect: 2

// @split
// Grouped, the marker covers the whole pattern and the binder still binds.
type Node { pub var n; init(this) { this.n = 1; } }
fn write(mut (p @ Node)) { p.n = 5; }
fn take(*(p @ Node))! { return p.n; }
say a = mut Node();
write(a);
print(take(a)); // expect: 5

// @split
// A grouped take is still a take.
type Node { pub var n; init(this) { this.n = 1; } }
fn take(*(p @ Node))! { return p.n; }
say a = mut Node();
print(take(a));
a.n = 2; // error: cannot write `a`, which gave its write-ownership away

// @split
// A combinator takes the marker grouped, which is the only spelling it has.
type Node { pub next?; init(this) { this.next = null; } }
fn f(*mut (p @ Node | null)) { }
print("ran"); // expect: ran
