// A built-in's factory carries the same parameter facts a written one does. Handing it a mutable
// value moves the write-ownership into what it builds, so the caller may not write it afterwards.
say a = mut [1];
say e: fails = mut Err(a);
e ?? 0;
a[0] = 2; // error: cannot write `a`, which gave its write-ownership away

// @split
// The same shape over a user type, which is the behaviour it is matched against.
type Box { pub v; init(this, *v) { this.v = v; } }
say a = mut [1];
say b = mut Box(a);
a[0] = 2; // error: cannot write `a`, which gave its write-ownership away

// @split
// Freezing the argument first hands over nothing, so the name keeps reading it.
say a = mut [1];
say e: fails = mut Err(freeze(a));
e ?? 0;
print(a[0]); // expect: 1
