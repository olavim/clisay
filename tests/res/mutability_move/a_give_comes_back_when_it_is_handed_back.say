fn id(mut c)! { return c; }
say a = mut [];
say b = id(a);
b.push(1);
print(b.length()); // expect: 1

// @split
say a = mut [0];
{ say b = a; b[0] = 1; }
a[0] = 2;
print(a[0]); // expect: 2

// @split
say a = mut [0];
{
    say b = a;
    { say c = b; c[0] = 1; }
    b[0] = 2;
}
a[0] = 3;
print(a[0]); // expect: 3
