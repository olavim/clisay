// A rebind drops the value the slot held, so whatever lent it gets its write-ownership back.
say a = mut [1];
say var b = a;
b = mut [2];
say c = a;
c[0] = 9;
print(c[0]); // expect: 9

// @split
// Without the rebind in between, the second give is still a second give.
say a = mut [1];
say b = a;
say c = a; // error: cannot give away `a`, which no longer writes its value

// @split
// Walking a chain is the shape this was costing. Each step rebinds, so the name it came from
// writes again and can be linked to.
say head = mut { next: 0 };
say var curr = head;
curr = mut { next: 0 };
curr["next"] = head;
print("linked"); // expect: linked

// @split
// A slot that gave its own write-ownership away has none to hand back, so a rebind changes nothing
// for the name it was given to.
say a = mut [1];
say var b = a;
say d = b;
b = mut [2];
d[0] = 7;
print(d[0]); // expect: 7
