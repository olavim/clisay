// A name holding something else is not the writer of what it used to hold.
say var a = mut [0];
a[0] = 1;
say keep = a;
a = mut [9];
keep[0] = 5;
print(keep[0]); // expect: 5

// @split
fn make()! { return mut [0]; }
say var a = make();
a[0] = 1;
say keep = a;
a = make();
keep[0] = 5;
print(keep[0]); // expect: 5

// @split
say var x = mut [0];
say var z = mut [0];
{ say inner = mut [mut [1]]; x = inner[0]; z = inner[0]; }
x[0] = 5;
x = mut [9];
z[0] = 6;
print(z[0]); // expect: 6

// @split
say var x = mut [0];
say var z = mut [0];
{ say inner = mut [mut [1]]; x = inner[0]; z = inner[0]; }
x[0] = 5;
z[0] = 6; // error: cannot write an element another name already writes
