// A callee's result may be a second name for a binding the caller holds, but only where the caller
// can hold that name. A local of the callee names nothing outside it, so sharing the spelling is
// not sharing the value.
fn helper()! { say g = mut [1]; return g; }
say g = mut [2];
say r = helper();
g[0] = 5;
print(g[0]); // expect: 5
print(r[0]); // expect: 1

// @split
// A bare field name is the receiver's member, so it means nothing in the caller's frame either.
type T { pub var n; pub fn get(this)! { return n; } }
say n = mut [1];
say t = mut T { n: mut [2] };
say r = t.get();
n[0] = 5;
print(n[0]); // expect: 5
print(r[0]); // expect: 2

// @split
// A name the callee really did take from an enclosing frame is the case the rule is for.
say g = mut [1];
fn helper()! { return g; }
say r = helper();
g[0] = 5; // error: cannot write `g`, which gave its write-ownership away

// @split
// And a returned parameter still hands the caller's argument on.
fn keep(v)! { return v; }
say a = mut [1];
say r = keep(a);
a[0] = 5; // error: cannot write `a`, which gave its write-ownership away
