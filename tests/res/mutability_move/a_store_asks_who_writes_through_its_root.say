// A `*mut` callee that hands the value back leaves the new name writing it, so the source may not.
// The store asks with its own root, so the refusal needs no barrier from codegen.
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut [0];
say b = fns[0](a);
a[0] = 1; // error: cannot write an element another name already writes

// @split
// The name that took it writes it.
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut [0];
say b = fns[0](a);
b[0] = 1;
print(b[0]); // expect: 1

// @split
// A field store asks the same question of the same root.
type T { pub var x; init(this, *v) { this.x = v; } }
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut T(0);
say b = fns[0](a);
a.x = 1; // error: cannot write an element another name already writes

// @split
// And lets the taker through.
type T { pub var x; init(this, *v) { this.x = v; } }
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut T(0);
say b = fns[0](a);
b.x = 1;
print(b.x); // expect: 1

// @split
// A mutating native method asks it too, through the receiver it was called on.
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut [];
say b = fns[0](a);
a.push(1); // error: cannot write an element another name already writes

// @split
// The taker calls it freely, and a read through the source is never refused.
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut [7];
say b = fns[0](a);
print(a.length()); // expect: 1
b.push(8);
print(b.length()); // expect: 2

// @split
// A value nobody handed over is written through any name that reaches it.
say a = mut [0];
say b = a;
print(b[0]); // expect: 0
