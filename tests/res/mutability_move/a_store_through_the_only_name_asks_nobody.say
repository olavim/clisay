// A store through the one name that reaches the value skips the one-writer arbitration, so a use
// that hands the value on has to take that proof back even when it comes after the store.
say a = mut [0];
a[0] = 1;
a[0] = 2;
print(a[0]); // expect: 2

// @split
// The value is handed on below the store, so the store still asks who writes.
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut [0];
a[0] = 1;
say b = fns[0](a);
a[0] = 2; // error: cannot write an element another name already writes

// @split
// The name that took it writes it.
fn id(*mut c)! { return c; }
say fns = mut [id];
say a = mut [0];
a[0] = 1;
say b = fns[0](a);
b[0] = 2;
print(b[0]); // expect: 2

// @split
// A field store is proven the same way.
type T { pub var x; init(this) { this.x = 0; } }
say t = mut T();
t.x = 1;
print(t.x); // expect: 1

// @split
// And gives the proof back to the same use.
type T { pub var x; init(this) { this.x = 0; } }
fn id(*mut c)! { return c; }
say fns = mut [id];
say t = mut T();
t.x = 1;
say u = fns[0](t);
t.x = 2; // error: cannot write an element another name already writes

// @split
// A container takes the value below the store, and the path write through the container is what
// the store's record refuses. Without it the write goes through and nothing says so.
say e = mut [0];
e[0] = 1;
say a = mut [e];
a[0][0] = 2; // error: cannot write an element another name already writes

// @split
// Reading it through the container is never refused.
say e = mut [0];
e[0] = 1;
say a = mut [e];
print(a[0][0]); // expect: 1

// @split
// A block around the store changes nothing, since the use below still reaches the same binding.
say a = mut [0];
{
    a[0] = 1;
}
say b = mut [a];
b[0][0] = 2; // error: cannot write an element another name already writes

// @split
// Reading an element through the name is not handing it on, so the proof stands.
say a = mut [0];
a[0] = 1;
print(a[0]); // expect: 1
a[0] = 2;
print(a[0]); // expect: 2

// @split
// Calling a method on the name is, since a method may keep its receiver.
say a = mut [0];
a[0] = 1;
a.push(2);
a[0] = 3;
print(a.length()); // expect: 2
