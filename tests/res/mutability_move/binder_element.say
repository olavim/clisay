// A binder names part of the value it was destructured out of, which is an extraction like any
// other. Writing through it takes that element's writer slot.
say a = mut [mut [0]];
if (a ~ [b]) {
    say d = a[0];
    b[0] = 1;
    d[0] = 2; // error: cannot write an element another name already writes
}

// @split
// The same against a write through a path.
say a = mut [mut [0]];
if (a ~ [b]) {
    b[0] = 1;
    a[0][0] = 2; // error: cannot write an element another name already writes
}

// @split
// Binders over distinct elements are distinct writers.
say a = mut [mut [0], mut [0]];
if (a ~ [b, c]) {
    b[0] = 1;
    c[0] = 2;
    print(a[0][0]); // expect: 1
    print(a[1][0]); // expect: 2
}

// @split
// A binder that only reads takes nothing.
say a = mut [mut [0]];
if (a ~ [b]) {
    say d = a[0];
    d[0] = 7;
    print(b[0]); // expect: 7
}

// @split
// An immutable scrutinee has no writer slot to hand out.
say a = [[0]];
if (a ~ [b]) {
    print(b[0]); // expect: 0
}

// @split
// A match arm binds the same way a condition does.
say a = mut [mut [0]];
match a {
    [b] => {
        say d = a[0];
        b[0] = 1;
        d[0] = 2; // error: cannot write an element another name already writes
    },
    _ => { print("no"); },
}

// @split
// And its binders over distinct elements stay distinct.
say a = mut [mut [0], mut [0]];
match a {
    [b, c] => {
        b[0] = 1;
        c[0] = 2;
        print(a[1][0]); // expect: 2
    },
    _ => { print("no"); },
}

// @split
// An `and` keeps each binder with its own scrutinee, so both sides write their own element.
say a = mut [mut [0]];
say x = mut [mut [0]];
if (a ~ [b] && x ~ [c]) {
    b[0] = 1;
    c[0] = 2;
    print(a[0][0]); // expect: 1
    print(x[0][0]); // expect: 2
}

// @split
// The left side's binder is the left side's element.
say a = mut [mut [0]];
say x = mut [mut [0]];
if (a ~ [b] && x ~ [c]) {
    say d = a[0];
    b[0] = 1;
    d[0] = 2; // error: cannot write an element another name already writes
}

// @split
// And the right side's is the right side's.
say a = mut [mut [0]];
say x = mut [mut [0]];
if (a ~ [b] && x ~ [c]) {
    say d = x[0];
    c[0] = 1;
    d[0] = 2; // error: cannot write an element another name already writes
}

// @split
// An immutable scrutinee beside a mutable one does not cost the mutable one its tracking.
say y = [[0]];
say a = mut [mut [0]];
if (y ~ [c] && a ~ [b]) {
    say d = a[0];
    b[0] = 1;
    d[0] = 2; // error: cannot write an element another name already writes
}

// @split
// Nor does it gain any of its own, since nothing can write it.
say y = [[0]];
say a = mut [mut [0]];
if (y ~ [c] && a ~ [b]) {
    print(c[0]); // expect: 0
    print(b[0]); // expect: 0
}

// @split
// Chaining keeps each binder with its own source.
say a = mut [mut [0]];
say x = mut [mut [0]];
say z = mut [mut [0]];
if (a ~ [b] && x ~ [c] && z ~ [e]) {
    say d = z[0];
    e[0] = 1;
    d[0] = 2; // error: cannot write an element another name already writes
}

// @split
// An `or` binds the same names on both sides, so either side names their sources.
say a = mut [mut [0]];
if (a ~ [b] || a ~ [b]) {
    say d = a[0];
    b[0] = 1;
    d[0] = 2; // error: cannot write an element another name already writes
}
