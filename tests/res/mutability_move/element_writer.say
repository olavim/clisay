// Two names for distinct elements are two writers of two values, so both may write.
say arr = mut [mut [0], mut [0]];
say arr0 = arr[0];
say arr1 = arr[1];
arr0[0] = 7;
arr1[0] = 9;
print(arr[0][0]); // expect: 7
print(arr[1][0]); // expect: 9

// @split
// The writer slot is released with the scope that took it, so the element can be named again.
say arr = mut [mut [0]];
{
    say brr = arr[0];
    brr[0] = 1;
}
say drr = arr[0];
drr[0] = 3;
print(arr[0][0]); // expect: 3

// @split
// Reading an element as many times as asked is fine while only one name writes it.
say arr = mut [mut [0]];
say c = arr[0];
say d = arr[0];
c[0] = 7;
print(d[0]); // expect: 7
print(arr[0][0]); // expect: 7

// @split
// A second name writing the same element is the violation.
say arr = mut [mut [0]];
say c = arr[0];
say d = arr[0];
c[0] = 7;
d[0] = 1; // error: cannot write an element another name already writes

// @split
// A mutating method takes the writer slot the same way an index write does.
say arr = mut [mut [0]];
say c = arr[0];
say d = arr[0];
c.push(1);
d.push(2); // error: cannot write an element another name already writes

// @split
// A dict value is an element too.
say m = mut {};
m["k"] = mut [0];
say c = m["k"];
say d = m["k"];
c[0] = 7;
d[0] = 1; // error: cannot write an element another name already writes

// @split
// Distinct dict keys are distinct elements.
say m = mut {};
m["a"] = mut [0];
m["b"] = mut [0];
say c = m["a"];
say d = m["b"];
c[0] = 7;
d[0] = 9;
print(m["b"][0]); // expect: 9

// @split
// A dict keys on any value, so `true`, `false` and `null` each name an element of their own.
say m = mut {};
m[true] = mut [0];
m[false] = mut [0];
m[null] = mut [0];
say t = m[true];
say f = m[false];
say n = m[null];
t[0] = 1;
f[0] = 2;
n[0] = 3;
print(m[true][0]); // expect: 1
print(m[false][0]); // expect: 2
print(m[null][0]); // expect: 3

// @split
// A key keeps its own value rather than an index, so a fractional key is not the whole number.
say m = mut {};
m[1] = mut [0];
m[1.5] = mut [0];
say c = m[1];
say d = m[1.5];
c[0] = 7;
d[0] = 9;
print(m[1.5][0]); // expect: 9

// @split
// The same non-string key twice is still one element.
say m = mut {};
m[true] = mut [0];
say c = m[true];
say d = m[true];
c[0] = 7;
d[0] = 1; // error: cannot write an element another name already writes

// @split
// A field is an element too.
type H { pub var item; init(this) { this.item = mut [0]; } }
say h = mut H();
say c = h.item;
say d = h.item;
c[0] = 7;
d[0] = 1; // error: cannot write an element another name already writes

// @split
// A rebind names whatever element the new value came out of.
say arr = mut [mut [0], mut [0]];
say c = arr[0];
say var d = arr[1];
d = arr[0];
c[0] = 7;
d[0] = 1; // error: cannot write an element another name already writes

// @split
// Rebinding away lets go of the writer slot the old value held.
say arr = mut [mut [0], mut [0]];
say var d = arr[0];
d[0] = 1;
d = arr[1];
say c = arr[0];
c[0] = 9;
print(arr[0][0]); // expect: 9

// @split
// One name per iteration is one writer at a time, so a loop over a container works.
say arr = mut [mut [0], mut [0]];
say var i = 0;
while (i < 2) {
    say e = arr[i];
    e[0] = 1;
    i = i + 1;
}
print(arr[0][0]); // expect: 1
print(arr[1][0]); // expect: 1
