// Two computed reads of one element, both written, is the same violation a literal key catches.
say arr = mut [mut [0], mut [0]];
say var i = 0;
say a = arr[i];
say b = arr[i];
a[0] = 1;
b[0] = 2; // error: cannot write an element another name already writes

// @split
// Computed indices that name different elements are two writers of two values.
say arr = mut [mut [0], mut [0]];
say var i = 0;
say var j = 1;
say a = arr[i];
say b = arr[j];
a[0] = 7;
b[0] = 9;
print(arr[0][0]); // expect: 7
print(arr[1][0]); // expect: 9

// @split
// A name that only reads takes no writer slot, so it never collides.
say arr = mut [mut [0]];
say var i = 0;
say a = arr[i];
say b = arr[i];
a[0] = 5;
print(b[0]); // expect: 5

// @split
// The slot goes back each time round, so a loop may revisit one element.
say arr = mut [mut [0]];
say var n = 0;
while (n < 3) {
    say e = arr[n - n];
    e[0] = n;
    n = n + 1;
}
print(arr[0][0]); // expect: 2

// @split
// A `return` past the scope that took the slot still gives it back.
say arr = mut [mut [0]];
fn touch(a: mut, k) { say e = a[k]; e[0] = 1; return; }
say var i = 0;
touch(arr, i);
touch(arr, i);
print(arr[0][0]); // expect: 1

// @split
// So does an unwind.
say arr = mut [mut [0]];
fn touch(a: mut, k) { say e = a[k]; e[0] = 1; throw "up"; }
say var i = 0;
try { touch(arr, i); } catch (e) { print("caught"); } // expect: caught
try { touch(arr, i); } catch (e) { print("caught"); } // expect: caught
print(arr[0][0]); // expect: 1
