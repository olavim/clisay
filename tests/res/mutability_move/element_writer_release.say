say arr = mut [mut [0]];
say var i = 0;
{ say a = arr[i]; a[0] = 1; }
{ say b = arr[i]; b[0] = 2; }
{ say c = arr[i]; c[0] = 3; }
print(arr[0][0]); // expect: 3

// @split
say arr = mut [mut [0]];
fn touch(mut a, k) { say e = a[k]; e[0] = 1; return; }
say var i = 0;
touch(arr, i);
touch(arr, i);
print(arr[0][0]); // expect: 1

// @split
say arr = mut [mut [0]];
fn touch(mut a, k) { say e = a[k]; e[0] = 2; }
say var i = 0;
touch(arr, i);
touch(arr, i);
print(arr[0][0]); // expect: 2

// @split
say arr = mut [mut [0]];
fn touch(mut a, k) { say var n = 0; while (n < 3) { say e = a[k]; e[0] = 3; return; } }
say var i = 0;
touch(arr, i);
touch(arr, i);
print(arr[0][0]); // expect: 3

// @split
say arr = mut [mut [0]];
fn touch(mut a, k) { say e = a[k]; e[0] = 4; throw "up"; }
say var i = 0;
try { touch(arr, i); } catch (e) { }
try { touch(arr, i); } catch (e) { }
print(arr[0][0]); // expect: 4

// @split
say arr = mut [mut [0]];
fn inner() { throw "up"; }
fn touch(mut a, k) { say e = a[k]; e[0] = 5; inner(); }
say var i = 0;
try { touch(arr, i); } catch (e) { }
try { touch(arr, i); } catch (e) { }
print(arr[0][0]); // expect: 5

// @split
say arr = mut [mut [0]];
fn touch(mut a, k) { try { say e = a[k]; e[0] = 6; return; } finally { } }
say var i = 0;
touch(arr, i);
touch(arr, i);
print(arr[0][0]); // expect: 6

// @split
type H { pub var v; init(this, mut a, k) { say e = a[k]; e[0] = 7; this.v = 0; } }
say arr = mut [mut [0]];
say var i = 0;
say h1 = mut H(arr, i);
say h2 = mut H(arr, i);
print(arr[0][0]); // expect: 7

// @split
type H { init(this) { } pub fn touch(this, mut a, k) { say e = a[k]; e[0] = 8; } }
say arr = mut [mut [0]];
say h = H();
say var i = 0;
h.touch(arr, i);
h.touch(arr, i);
print(arr[0][0]); // expect: 8

// @split
say arr = mut [mut [0]];
fn touch(mut a, k) { say e = a[k]; e[0] = 9; }
say f = touch;
say var i = 0;
f(arr, i);
f(arr, i);
print(arr[0][0]); // expect: 9

// @split
say arr = mut [mut [0], mut [0]];
fn down(mut a, n) { say e = a[n - n]; e[0] = n; if (n > 0) { down(a, n - 1); } }
down(arr, 0);
down(arr, 0);
print(arr[0][0]); // expect: 0

// @split
say arr = mut [mut [0]];
say var i = 0;
try { throw "up"; } catch (x) { say e = arr[i]; e[0] = 1; }
try { throw "up"; } catch (x) { say e = arr[i]; e[0] = 2; }
print(arr[0][0]); // expect: 2

// @split
say arr = mut [mut [0], mut [0]];
say var i = 0;
say var j = 1;
say outer = arr[i];
outer[0] = 1;
{ say a = arr[j]; a[0] = 2; }
{ say b = arr[j]; b[0] = 3; }
print(arr[0][0]); // expect: 1
print(arr[1][0]); // expect: 3

// @split
say arr = mut [mut [0], mut [0]];
say var d = arr[0];
d[0] = 1;
d = arr[1];
say c = arr[0];
c[0] = 9;
print(arr[0][0]); // expect: 9

// @split
say arr = mut [mut [0], mut [0]];
say var i = 1;
say var d = arr[0];
d[0] = 1;
d = arr[i];
d[0] = 5;
say c = arr[0];
c[0] = 9;
print(arr[0][0]); // expect: 9
print(arr[1][0]); // expect: 5

// @split
say arr = mut [mut [0]];
say var i = 0;
say var n = 0;
while (n < 3) {
    say e = arr[i];
    e[0] = n;
    if (n > 100) { print("no"); } else { }
    n = n + 1;
}
print(arr[0][0]); // expect: 2

// @split
say arr = mut [mut [0]];
say var i = 0;
say var n = 0;
while (n < 500) { say e = arr[i]; e[0] = n; n = n + 1; }
print(arr[0][0]); // expect: 499

// @split
say arr = mut [mut [0]];
say var i = 0;
say e = arr[i];
e[0] = 1;
gcCollect();
say var n = 0;
while (n < 200) { say junk = mut [n]; n = n + 1; }
gcCollect();
print(e[0]); // expect: 1
