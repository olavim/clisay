// A call that hands its argument back gives the caller a second name for it, so binding the result
// moves the original the way any other second name would.
type Box { pub mut v; init(this) { this.v = 0; } }
fn f(x: mut)!: mut { return x; }
say a = mut Box();
say b = f(a);
a.v = 1; // error: value used after it was moved
