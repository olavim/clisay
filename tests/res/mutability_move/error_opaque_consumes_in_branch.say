// The fact survives a branch join: retained on one path and written after, so the write still fails.
type Box { pub var v; init(this) { this.v = 0; } }
fn eats(x: *mut) { }
say consume = eats;
say a = mut Box();
if (1 > 0) {
    consume(a);
}
a.v = 1; // error: cannot write a value whose write-ownership was given away
