// A loop's next turn hands the same binding over again, and the second retain is what fails.
type Box { pub var v; init(this) { this.v = 0; } }
fn eats(*mut x) { }
say consume = eats;
say a = mut Box();
say var i = 0;
while (i < 2) {
    consume(a); // error: cannot retain a value whose write-ownership was already taken
    i = i + 1;
}
