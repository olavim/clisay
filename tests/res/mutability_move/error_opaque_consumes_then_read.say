// Reading the argument again is what makes the callee's choice matter, so the call alone is fine and
// the read is what fails.
type Box { pub mut v; init(this) { this.v = 0; } }
fn eats(x: *mut) { }
say consume = eats;
say a = mut Box();
consume(a);
a.v = 1; // error: value used after a call consumed it
