say var n = 0;
say a = mut [1];
while n < 3 {
  say x = a[0];
  n = n + 1;
}
print(a[0]); // expect: 1

// @split
fn consume(mut x) {}
say var n = 0;
say var a = mut [1];
while n < 3 {
  consume(a);
  a = mut [2];
  n = n + 1;
}
print(a[0]); // expect: 2

// @split
fn consume(mut x) {}
say var n = 0;
say var a = mut [1];
while n < 3 {
  a = mut [2];
  consume(a);
  n = n + 1;
}
print("ok"); // expect: ok
