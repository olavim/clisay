// Binding a mutable value hands the new name its write-ownership. The source keeps reading it.
say a = mut [1, 2];
say b = a;
print(b[0]); // expect: 1

// @split
say a = mut [1, 2];
say b = a;
print(a[0]); // expect: 1


// @split
// A block-scoped give returns the write-ownership when the block-local dies.
say a = mut [1, 2];
{ say b = a; }
print(a[0]); // expect: 1