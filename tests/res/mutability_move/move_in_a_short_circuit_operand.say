// The right operand of a short-circuit runs on a path through the condition, not instead of one,
// so a value it was given stays given after the condition too.
fn eats(*mut x)! { return 1; }
say a = mut [1];
if (true && eats(a) == 1) { }
print(a[0]); // expect: 1

// @split
fn eats(*mut x)! { return 1; }
say a = mut [1];
if (false || eats(a) == 1) { }
print(a[0]); // expect: 1

// @split
// A condition that moves nothing leaves the value readable.
fn reads(x)! { return 1; }
say a = mut [1];
if (true && reads(a[0]) == 1) { }
print(a[0]); // expect: 1
