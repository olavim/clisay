// A returning match arm moves the value only on its own path; the fall-through keeps it live.
fn build(n): mut {
  say a = mut [1, 2];
  match n {
    0 => { return a; },
    _ => {},
  }
  a[0] = 3;
  return a;
}
print(build(9)[0]); // expect: 3
print(build(0)[0]); // expect: 1

// @split
// A move in a fall-through arm is still a move after the match, so the later use is rejected.
fn consume(xs: move mut) {}
say a = mut [1, 2];
match a[0] {
  1 => { consume(a); },
  _ => {},
}
print(a[0]); // error: 'a' is used after it is moved
