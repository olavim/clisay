// The receiver is a borrowed argument, so two method calls are two borrows, not a move.
type Box {
  pub var v;
  init(this) { this.v = 0; }
  pub fn setV(mut this, *x)! { this.v = x; return this; }
  pub fn get(this)! { return this.v; }
}
say b = mut Box();
b.setV(1);
b.setV(2);
print(b.get()); // expect: 2
