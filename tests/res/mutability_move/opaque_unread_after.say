type Box { pub var v; init(this) { this.v = 0; } }
fn eats(mut x) { }
fn borrows(mut x) { x.v = 1; }
say consume = eats;
say lend = borrows;
say a = mut Box();
consume(a);
say b = mut Box();
lend(b);
say c = mut Box();
if (1 > 0) { consume(c); }
say d = mut Box();
say var i = 0;
while (i < 2) { i = i + 1; }
consume(d);
print("ok"); // expect: ok
