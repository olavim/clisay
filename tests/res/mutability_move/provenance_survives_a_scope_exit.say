// A source that dies with its scope stands for whatever it came from, so a binding outliving the
// block keeps a chain to a live holder. The index it left behind used to crash the check pass.
say var k = mut [];
{ say c = mut [1]; k = c; }
print(k[0]); // expect: 1

// @split
// A source nothing moved out of is handed back when its scope ends.
say a = mut [1];
{ say c = a; }
a[0] = 5;
print(a[0]); // expect: 5

// @split
// One that was moved on is not, since the value went past the block.
say a = mut [1];
say var k = mut [];
{ say c = a; k = c; }
a[0] = 5; // error: cannot write `a`, which gave its write-ownership away

// @split
// And the binding it went to holds it.
say a = mut [1];
say var k = mut [];
{ say c = a; k = c; }
k[0] = 5;
print(k[0]); // expect: 5

// @split
// Either branch could have run, so a join names both sources.
fn run(k) {
    say a = mut [1];
    say b = mut [2];
    { say var h = mut []; if (k == 1) { h = a; } else { h = b; } }
    a[0] = 5;
    b[0] = 6;
    print(a[0]); // expect: 5
    print(b[0]); // expect: 6
}
run(1);

// @split
// A block that hands the value out keeps the move, whichever branch supplied it.
fn run(k) {
    say a = mut [1];
    say b = mut [2];
    say var kept = mut [];
    { say var h = mut []; if (k == 1) { h = a; } else { h = b; } kept = h; }
    a[0] = 5; // error: cannot write `a`, which gave its write-ownership away
}
run(1);

// @split
// And the source the other branch named is held just the same.
fn run(k) {
    say a = mut [1];
    say b = mut [2];
    say var kept = mut [];
    { say var h = mut []; if (k == 1) { h = a; } else { h = b; } kept = h; }
    b[0] = 5; // error: cannot write `b`, which gave its write-ownership away
}
run(1);

// @split
// The chain can be longer than one link, and every dying step splices out the same way.
say a = mut [1];
say var k = mut [];
{
    say b = a;
    { say c = b; k = c; }
}
a[0] = 5; // error: cannot write `a`, which gave its write-ownership away
