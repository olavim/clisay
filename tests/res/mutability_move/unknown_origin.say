// A form the aliasing rules were never taught yields a value they treat as shared, so it takes the
// runtime writer slot. Only a few forms prove exclusivity, and everything else is guarded.

// An element of a call result: the container is no binding, so the read is no tracked extraction.
say g = mut [mut [0]];
fn one()! { return g; }
say a = one()[0];
say b = one()[0];
a[0] = 1;
b[0] = 2; // error: cannot write an element another name already writes

// @split
// An element of an element, whose container is itself a path.
say g = mut [mut [mut [0]]];
say a = g[0][0];
say b = g[0][0];
a[0] = 1;
b[0] = 2; // error: cannot write an element another name already writes

// @split
// An element of a handled call, where the value comes from one of two branches.
say g = mut [mut [0]];
fn one()! { return g; }
say a = (one() ?? e => mut [mut [0]])[0];
say b = (one() ?? e => mut [mut [0]])[0];
a[0] = 1;
b[0] = 2; // error: cannot write an element another name already writes

// @split
// A receiver is no binding either, so a name that took its writer slot is a second writer.
type C {
    pub var v;
    init(this) { this.v = 0; }
    pub fn go(this: mut) {
        say p = this;
        p.v = 1;
        this.v = 2; // error: cannot write an element another name already writes
    }
}
say c = mut C();
c.go();

// @split
// A fresh value proves exclusivity, so it takes nothing.
say a = mut [0];
say b = mut [0];
a[0] = 1;
b[0] = 2;
print(a[0]); // expect: 1
print(b[0]); // expect: 2

// @split
// So does a construction.
type C { pub var v; init(this) { this.v = 0; } }
say a = mut C();
say b = mut C();
a.v = 1;
b.v = 2;
print(a.v); // expect: 1
print(b.v); // expect: 2

// @split
// Distinct elements of one container are distinct writers.
say a = mut [mut [0], mut [0]];
say p = a[0];
say q = a[1];
p[0] = 1;
q[0] = 2;
print(a[0][0]); // expect: 1
print(a[1][0]); // expect: 2

// @split
// One name writes through its own slot as often as it likes.
say a = mut [mut [0]];
say p = a[0];
p[0] = 1;
p[0] = 2;
p[0] = 3;
print(a[0][0]); // expect: 3

// @split
// A method writing its own fields needs no name to hold anything.
type C {
    pub var v;
    init(this) { this.v = 0; }
    pub fn go(this: mut) { this.v = 1; this.v = 2; }
}
say c = mut C();
c.go();
print(c.v); // expect: 2
