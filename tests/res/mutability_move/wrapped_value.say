// A wrapper yields the value it wraps, so the aliasing rules read through it. Each section names
// one element twice through a different wrapper, and writes through both.

// `!` around a call.
say g = mut [0];
fn f()! { return g; }
say a = f()!;
say b = f()!;
a[0] = 1;
b[0] = 2; // error: cannot write an element another name already writes

// @split
// `!` around the container of an extraction.
say a = mut [mut [0]];
say b = a![0];
say c = a![0];
b[0] = 1;
c[0] = 2; // error: cannot write an element another name already writes

// @split
// The null-guarded read names the same element a plain one does.
say a = mut [mut [0]];
say b = a?[0]!;
say c = a?[0]!;
b[0] = 1;
c[0] = 2; // error: cannot write an element another name already writes

// @split
// A null-guarded call is still a call.
say g = mut [0];
fn f()! { return g; }
say q = f;
say a = q?()!;
say b = q?()!;
a[0] = 1;
b[0] = 2; // error: cannot write an element another name already writes

// @split
// So is one behind `?!`.
say g = mut [0];
fn f()! { return g; }
fn use2()! {
    say a = f()?!;
    say b = f()?!;
    a[0] = 1;
    b[0] = 2; // error: cannot write an element another name already writes
    return 0;
}
print(use2()!);

// @split
// A handler yields either branch, so a call on one of them counts.
say g = mut [0];
fn f()! { return g; }
say a = f() ?? e => mut [9];
say b = f() ?? e => mut [9];
a[0] = 1;
b[0] = 2; // error: cannot write an element another name already writes

// @split
// A write target behind a wrapper is still the name it wraps.
say a = mut [mut [0]];
say e = a[0];
say d = a[0];
e[0] = 1;
d![0] = 2; // error: cannot write an element another name already writes

// @split
// Reading through wrappers names distinct elements distinctly.
say a = mut [mut [0], mut [0]];
say b = a![0];
say c = a![1];
b[0] = 1;
c[0] = 2;
print(a[0][0]); // expect: 1
print(a[1][0]); // expect: 2

// @split
// A construction behind `mut` is still a fresh value.
type C { pub mut v; init(this) { this.v = 0; } }
say a = mut C();
say b = mut C();
a.v = 1;
b.v = 2;
print(a.v); // expect: 1
print(b.v); // expect: 2
