// A `: mut` factory hands back a live mutable value built through fluent methods.
type UserBuilder {
  pub var name;
  init(this) { this.name = ""; }
  pub fn setName(this: mut, n)! { this.name = n; return this; }
  pub fn build(this)! { return this.name; }
}
fn getBuilder(): mut {
  say b = mut UserBuilder();
  b.setName("default");
  return b;
}
say builder = getBuilder();
say user = builder.build();
print(user); // expect: default
