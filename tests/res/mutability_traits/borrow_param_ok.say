// A borrow hole is satisfied by either a borrow or a consuming param.
trait Sink {
    req fn accept(x: mut);
}
type Db with Sink {
    pub fn accept(x: mut) { }
    init() {}
}
say d = Db();
print("ok"); // expect: ok

// @split
trait Sink {
    req fn accept(x: mut);
}
type Db with Sink {
    pub fn accept(x: *mut) { }
    init() {}
}
say d = Db();
print("ok"); // expect: ok
