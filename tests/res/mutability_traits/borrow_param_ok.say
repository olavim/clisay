// A borrow hole is satisfied by either a borrow or a consuming param.
trait Sink {
    req fn accept(this, x: mut);
}
type Db with Sink {
    pub fn accept(this, x: mut) { }
    init(this) {}
}
say d = Db();
print("ok"); // expect: ok

// @split
trait Sink {
    req fn accept(this, x: mut);
}
type Db with Sink {
    pub fn accept(this, x: *mut) { }
    init(this) {}
}
say d = Db();
print("ok"); // expect: ok
