// A borrow hole is satisfied by either a borrow or a consuming param.
trait Sink {
    req fn accept(this, mut x);
}
type Db with Sink {
    pub fn accept(this, mut x) { }
    init(this) {}
}
say d = Db();
print("ok"); // expect: ok

// @split
trait Sink {
    req fn accept(this, mut x);
}
type Db with Sink {
    pub fn accept(this, *mut x) { }
    init(this) {}
}
say d = Db();
print("ok"); // expect: ok
