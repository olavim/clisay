// A closure that rebinds the binding reaches it through the call, so the narrowing does not survive
// the call. Without this the binding reads `null` through a non-null name at run time.
type Box { pub value: opt; }
fn run() {
    say mut b = Box { value: "v" };
    if (b.value == null) { return; }
    say f = () => { b = Box { value: null }; return 1; };
    f();
    say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
    print(y);
}
run();

// @split
// A call that rebinds some other name leaves this one's narrowing standing. The invalidation is
// per name, not a blanket one whenever anything rebinds.
type Box { pub value: opt; }
fn run() {
    say mut b = Box { value: "v" };
    say mut c = Box { value: "c" };
    say f = () => { c = Box { value: null }; return 1; };
    if (b.value == null) { return; }
    f();
    say y = b.value;
    print(y); // expect: v
}
run();

// @split
// A call that rebinds nothing leaves the narrowing standing.
type Box { pub value: opt; }
fn other()! { return 1; }
fn run() {
    say mut b = Box { value: "v" };
    if (b.value == null) { return; }
    other();
    say y = b.value;
    print(y); // expect: v
}
run();

// @split
// A call inside the condition runs before the branch does, so a narrowing the same condition
// proves is already stale where it would be used.
type Box { pub value: opt; }
fn run() {
    say mut b = Box { value: "v" };
    say f = () => { b = Box { value: null }; return true; };
    if (b.value != null && f()) {
        say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
        print(y);
    }
}
run();

// @split
// A loop body that rebinds drops it for the next iteration, which is the path a single pass misses.
type Box { pub value: opt; }
fn run() {
    say mut b = Box { value: "v" };
    if (b.value == null) { return; }
    say mut i = 0;
    while (i < 2) {
        say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
        print(y);
        b = Box { value: null };
        i = i + 1;
    }
}
run();
