type Box { pub value: opt; }
fn run() {
    say var b = Box { value: "v" };
    if (b.value == null) { return; }
    say f = () => { b = Box { value: null }; return 1; };
    f();
    say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
    print(y);
}
run();

// @split
type Box { pub value: opt; }
fn run() {
    say var b = Box { value: "v" };
    say var c = Box { value: "c" };
    say f = () => { c = Box { value: null }; return 1; };
    if (b.value == null) { return; }
    f();
    say y = b.value;
    print(y); // expect: v
}
run();

// @split
type Box { pub value: opt; }
fn other()! { return 1; }
fn run() {
    say var b = Box { value: "v" };
    if (b.value == null) { return; }
    other();
    say y = b.value;
    print(y); // expect: v
}
run();

// @split
type Box { pub value: opt; }
fn run() {
    say var b = Box { value: "v" };
    say f = () => { b = Box { value: null }; return true; };
    if (b.value != null && f()) {
        say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
        print(y);
    }
}
run();

// @split
type Box { pub value: opt; }
fn run() {
    say var b = Box { value: "v" };
    if (b.value == null) { return; }
    say var i = 0;
    while (i < 2) {
        say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
        print(y);
        b = Box { value: null };
        i = i + 1;
    }
}
run();
