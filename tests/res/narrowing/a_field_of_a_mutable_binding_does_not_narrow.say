// A mutable binding can be rebound, so proving something about its field proves nothing later.
// @split
type Box { pub value: opt; }
fn run() {
    say mut b = Box { value: "v" };
    if (b.value == null) { return; }
    say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
    print(y);
}
run();
// @split
//  An immutable binding does narrow.
type Box { pub value: opt; }
fn run() {
    say b = Box { value: "v" };
    if (b.value == null) { return; }
    say y = b.value;
    print(y); // expect: v
}
run();
