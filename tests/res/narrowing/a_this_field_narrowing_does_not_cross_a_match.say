// An arm that proves `this.value != null` and returns must not leave that in force for the arms
// beside it, which run instead of it rather than after it.
type W {
    pub value?;
    init(this, v?) { this.value = v; }
    pub fn go(this, k)! {
        match (k) {
            1 => { if (this.value != null) { return "has"; } return "none"; },
            _ => { return this.value.length(); }, // error: unchecked value owes 'opt'
        }
    }
}
say w = W(null);
print(w.go(2));
