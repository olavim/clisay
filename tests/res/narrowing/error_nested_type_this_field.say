type T {
    x: opt;
    init(this, a: opt) { this.x = a; }
    pub fn run(this) {
        if (this.x == null) { return; }
        type K {
            x: opt;
            init(this) { this.x = null; }
            pub fn runK(this) { print(this.x + 1); } // error: unchecked value owes 'opt'
        }
        K().runK();
    }
}
