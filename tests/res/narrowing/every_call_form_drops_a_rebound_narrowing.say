type Box { pub value: opt; }
fn run() {
    say var b = Box { value: "v" };
    say f = () => { b = Box { value: null }; return 1; };
    if (b.value == null) { return; }
    f?();
    say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
    print(y);
}
run();

// @split
fn maybe(k)! : opt { if (k == 1) { return null; } return "v"; }
fn run(k) {
    say var a: opt = maybe(k);
    say f = () => { a = null; return 1; };
    if (a == null) { return; }
    f();
    say y = a; // error: Cannot assign a nullable value to non-null binding 'y'
    print(y);
}
run(2);

// @split
type Box { pub value: opt; }
fn tick(g)! { return g(); }
fn run() {
    say var b = Box { value: "v" };
    say f = () => { b = Box { value: null }; return 1; };
    if (b.value != null && f() == 1 && tick(() => { if (1 == 1) { say q = 2; print(q); } return 1; }) == 1) {
        say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
        print(y);
    }
}
run();

// @split
type Box { pub value: opt; }
fn other() { say var b = Box { value: "x" }; say f = () => { b = Box { value: null }; return 1; }; f(); }
fn run() {
    say b = Box { value: "v" };
    if (b.value == null) { return; }
    print("hi"); // expect: hi
    say y = b.value;
    print(y); // expect: v
}
run();

// @split
type Box { pub value: opt; }
fn helper() { print("h"); }
fn run() {
    say var b = Box { value: "v" };
    say f = () => { b = Box { value: null }; return 1; };
    if (b.value == null) { return; }
    helper();
    say y = b.value; // error: Cannot assign a nullable value to non-null binding 'y'
    print(y);
}
run();

// @split
type T { pub value: opt; }
fn other() { say var x = T { value: "o" }; say f = () => { x = T { value: null }; return 1; }; f(); }
fn harmless()! { return 1; }
fn run() {
    say var x = T { value: "v" };
    if (x.value == null) { return; }
    harmless();
    say y = x.value;
    print(y); // expect: v
}
run();

