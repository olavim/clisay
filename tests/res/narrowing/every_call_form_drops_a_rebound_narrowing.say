// @split
fn maybe(k)! : opt { if (k == 1) { return null; } return "v"; }
fn other() { say var p = 1; say g = () => { p = 2; return 1; }; g(); }
fn helper()! { return 1; }
fn run(p: opt) {
    say peek = () => { return p; };
    if (p == null) { return; }
    helper();
    say y = p; // error: Cannot assign a nullable value to non-null binding 'y'
    print(y);
}
run(maybe(2));

// @split
fn maybe(k)! : opt { if (k == 1) { return null; } return "v"; }
fn other() { say var p = 1; say g = () => { p = 2; return 1; }; g(); }
fn helper()! { return 1; }
fn run(p: opt) {
    if (p == null) { return; }
    helper();
    say y = p;
    print(y); // expect: v
}
run(maybe(2));

// @split
fn maybe(k)! : opt { if (k == 1) { return null; } return "v"; }
fn other() { say var v = 1; say g = () => { v = 2; return 1; }; g(); }
fn helper()! { return 1; }
fn run(k) {
    match (maybe(k)) {
        v => {
            if (v == null) { return; }
            helper();
            say y = v;
            print(y); // expect: v
        },
    }
}
run(2);

// @split
fn maybe(k)! : opt { if (k == 1) { return null; } return "v"; }
fn other() { say var v = 1; say g = () => { v = 2; return 1; }; g(); }
fn helper()! { return 1; }
fn run(k) {
    match (maybe(k)) {
        v => {
            say peek = () => { return v; };
            if (v == null) { return; }
            helper();
            say y = v; // error: Cannot assign a nullable value to non-null binding 'y'
            print(y);
        },
    }
}
run(2);

// @split
type Box { pub value: opt; }
fn run() {
    say var b = Box { value: "v" };
    say f = () => { b = Box { value: null }; return 1; };
    if (b.value == null) { return; }
    print("hi"); // expect: hi
    say y = b.value;
