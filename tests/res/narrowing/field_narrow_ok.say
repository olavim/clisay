// A field without `var` narrows after a guard.
type Node {
    pub next?;
    pub var prev?;
    pub fn check(this)! {
        if (this.next != null) {
            this.next.x;
        }
        say p? = this.prev;
        if (p != null) {
            p.x;
        }
        return 1;
    }
}
print("ok"); // expect: ok
