type Cache {
    pub fn find(this): opt {
        return 1;
    }
}
type Other {
    pub fn find(this): opt {
        return 2;
    }
}
fn pick(flag: opt) {
    say var x = Cache();
    if (flag != null) {
        x = Other();
    }
    say hit = x.find();
    print(hit);
}
pick(null); // expect: 1
