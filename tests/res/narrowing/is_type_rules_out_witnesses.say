type A { }
type Warn { }
obligation warned { witness Warn; discharge to use; }
fn src(): warned { return Warn { }; }
say v: warned = src();
if (v is A) { say y = v; }
print("ok"); // expect: ok

// @split
type Warn { }
obligation warned { witness Warn; discharge to use; }
fn src(): warned { return Warn { }; }
say v: warned = src();
if (v is Warn) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
trait Wt { }
type T with Wt { }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return T { }; }
say v: warned = src();
if (v is T) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
trait Tr { }
trait Wt { }
type Both with Tr, Wt { }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Both { }; }
say v: warned = src();
if (v is Tr) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
type A { }
obligation taint { no persist; }
fn src(): taint { return A { }; }
say v: taint = src();
if (v is A) {
    say a = [v]; // error: cannot store value owing 'taint' in a container
}
