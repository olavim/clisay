fn g(): opt { return null; }
say x: opt = g();
if (x == 5) { say y = x; print("five"); }
print("end"); // expect: end

// @split
fn g(): opt { return null; }
say x: opt = g();
if (x != 5) { print("other"); } else { say y = x; print("five"); } // expect: other
print("end"); // expect: end

// @split
fn g(): opt { return null; }
say x: opt = g();
if (x == "a") { say y = x; }
if (x == true) { say z = x; }
print("end"); // expect: end

// @split
fn g(): opt { return null; }
say x: opt = g();
if (x == null) { print("null"); } else { say y = x; print("other"); } // expect: null
print("end"); // expect: end

// @split
fn f(): fails { return Err("e"); }
say x: fails = f();
if (x == 5 || !(x ~ Err)) { say y = x; print("clean"); }
print("end"); // expect: end

// @split
fn f(): fails { return Err("e"); }
say x: fails = f();
if (true && !(x ~ Err)) { print("in"); }
print("end"); // expect: end

// @split
type T { }
fn f(): fails { return Err("e"); }
say x: fails = f();
say y = T { };
if (x == y || !(x ~ Err)) { say z = x; print("clean"); }
print("end"); // expect: end

// @split
fn f(): fails { return Err("e"); }
say a: fails = f();
say b: fails = f();
if (a == b || !(a ~ Err)) {
    say z = a; // error: cannot assign a value owing 'fails' to 'z'
}
