type A { } type B { }
type Wt { }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Wt { }; }
say v: warned = src();
if (v is B) { say y = v; }
say w: warned = src();
if (w ~ B) { say z = w; }
print("ok"); // expect: ok

// @split
type A { } type B { }
type Wt { }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Wt { }; }
say v: warned = src();
if (v ~ A | B) { say y = v; }
print("ok"); // expect: ok

// @split
type A { }
type Wt { }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Wt { }; }
say v: warned = src();
if (v ~ A | Wt) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
type Wt { }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Wt { }; }
say v: warned = src();
if (v ~ Wt) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
trait Tr { }
trait Wt { }
type Both with Tr, Wt { }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Both { }; }
say v: warned = src();
if (v ~ Tr) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
type Wt { pub x; init(this) { this.x = 1; } }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Wt(); }
say v: warned = src();
if (v ~ { x: _ }) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
type B { pub x; init(this) { this.x = 1; } }
fn maybe(): opt { return null; }
say v: opt = maybe();
if (v ~ B) { say y = v; }
say w: opt = maybe();
if (w ~ { x: _ }) { say z = w; }
print("ok"); // expect: ok
