// A nested type resolves `this` against its own layout, and a narrowing inside it stays inside.
type T {
    x: opt;
    init(a: opt) { this.x = a; }
    pub fn run() {
        type K {
            x;
            init() { this.x = 1; }
            pub fn runK() { print(this.x + 1); }
        }
        K().runK(); // expect: 2
        print(this.x ?? "outer still owes"); // expect: 5
    }
}
T(5).run();
