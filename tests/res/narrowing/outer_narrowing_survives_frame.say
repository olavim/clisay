// Checking a nested body leaves the enclosing frame's narrowings intact, so `t.x` is still narrowed
// after the nested type closes.
type T {
    pub x: opt;
    init(this, *a: opt) { this.x = a; }
    pub fn run(this) {
        say t = this;
        if (t.x == null) { return; }
        type K {
            pub fn runK(this) { print("k"); }
        }
        K().runK();     // expect: k
        print(t.x + 1); // expect: 6
    }
}
T(5).run();
