// @split
trait Wt { }
obligation warned { witness Wt; discharge to use; }
type T { pub a; init(this) { this.a = 1; } }
type W with Wt { pub a; init(this) { this.a = 1; } }
fn src(): warned { return W(); }
say v: warned = src();
if (v ~ has T) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

