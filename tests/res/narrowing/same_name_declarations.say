trait Wt { }
obligation warned { witness Wt; discharge to use; }
fn mk(): warned { type T with Wt { } return T { }; }
fn probe() {
    type T { }
    say v: warned = mk();
    if (v is T) { say y = v; }
    print("ok"); // expect: ok
}
probe();

// @split
trait Wt { }
obligation warned { witness Wt; discharge to use; }
fn other() { type T { } }
fn probe(): warned {
    type T with Wt { }
    say v: warned = T { };
    if (v is T) {
        say y = v; // error: cannot assign a value owing 'warned' to 'y'
    }
    return T { };
}

// @split
obligation warned { witness Wt; discharge to use; }
type Wt { pub a; init(this) { this.a = 1; } }
fn mk(): warned { return Wt(); }
say v: warned = mk();
if (v ~ { a: _ }) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

