fn src(): fails { return Err("e"); }
say v: fails = src();
if (v ~ { x: _ }) { say y = v; }
print(v ?? "ok"); // expect: ok

// @split
fn src(): fails { return Err("e"); }
say v: fails = src();
if (v ~ { value: _ }) {
    say y = v; // error: cannot assign a value owing 'fails' to 'y'
}

// @split
fn src(): fails { return Err("e"); }
say v: fails = src();
if (v ~ { x: _, value: _ }) { say y = v; }
print(v ?? "ok"); // expect: ok

// @split
type Wt { pub a; init(this) { this.a = 1; } }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Wt(); }
say v: warned = src();
if (v ~ { zzz: _ }) { say y = v; }
print("ok"); // expect: ok

// @split
type Wt { pub a; init(this) { this.a = 1; } }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return Wt(); }
say v: warned = src();
if (v ~ { a: _ }) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
trait Wt { }
type T with Wt { pub other; init(this) { this.other = 1; } }
obligation warned { witness Wt; discharge to use; }
fn src(): warned { return T(); }
say v: warned = src();
if (v ~ { x: _ }) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}
