type Wt { pub a; }
obligation warned { witness Wt; discharge to use; }
type T { pub b; }
fn src(): warned { return Wt { a: 0 }; }
say v: warned = src();
if (v ~ has T) { say y = v; }
print("ok"); // expect: ok

// @split
type Wt { pub a; }
obligation warned { witness Wt; discharge to use; }
type T { pub a; }
fn src(): warned { return Wt { a: 0 }; }
say v: warned = src();
if (v ~ has T) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}

// @split
type Wt { pub a; }
obligation warned { witness Wt; discharge to use; }
type T { pub a; pub b; }
fn src(): warned { return Wt { a: 0 }; }
say v: warned = src();
if (v ~ has T) { say y = v; }
print("ok"); // expect: ok

// @split
trait Wt { }
obligation warned { witness Wt; discharge to use; }
type T { pub b; }
type W with Wt { pub a; }
fn src(): warned { return W { a: 0 }; }
say v: warned = src();
if (v ~ has T) {
    say y = v; // error: cannot assign a value owing 'warned' to 'y'
}
