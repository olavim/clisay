type Box {
    pub var value;
    init(this, v) {
        value = v;
    }
    pub fn get(this)! {
        return this.value;
    }
}
fn makeBox(v)!: mut {
    return mut Box(v);
}
fn describe(b?)! {
    return "a box";
}
say b = makeBox(10);
b.value = 20;
print(b.get()); // expect: 20
print(describe(b)); // expect: a box
