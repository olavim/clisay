type Box {
    pub var value;
    init(this, v) {
        this.value = v;
    }
    pub fn get(this) {
        return this.value;
    }
}
fn makeBox(v) {
    return Box(v);
}
fn describe(b: opt) {
    return "a box";
}
say var b = makeBox(10);
b.value = 20;
print(b.get()); // expect: 20
print(describe(b)); // expect: a box
