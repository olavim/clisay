// A nullable `req fn` is satisfied by a non-null member, since non-null is more specific.
trait Cache {
    req fn find(this)?;
    pub fn lookup(this)? {
        return this.find();
    }
}
type Store with Cache {
    pub fn find(this)! {
        return 1;
    }
}
say s = Store();
print("ok"); // expect: ok
