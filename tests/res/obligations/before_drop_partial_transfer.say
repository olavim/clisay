type Flag1 { } obligation obl1 { witness Flag1; must use; }
type Flag2 { } obligation obl2 { witness Flag2; must use; }

fn takesBoth(y: obl1 obl2) { y!; }
fn make(): obl1 obl2 { return 1; }

fn handOver(x: obl1 obl2) { takesBoth(x); }

say v: obl1 obl2 = make();
takesBoth(v);
print("ok"); // expect: ok
