// The debt is a set, so a transfer settles only what its destination declares. A parameter that
// admits both obligations takes both; one that admits only part is rejected by conformance first.
type Flag1 { } obligation obl1 { witness Flag1; discharge before drop; }
type Flag2 { } obligation obl2 { witness Flag2; discharge before drop; }

fn takesBoth(y: obl1 obl2) { y!; }
fn make(): obl1 obl2 { return 1; }

fn handOver(x: obl1 obl2) { takesBoth(x); }

say v: obl1 obl2 = make();
takesBoth(v);
print("ok"); // expect: ok
