type Token { pub v; init(this, x) { this.v = x; } }
obligation parsed { witness Token; discharge to use; }
fn make() { return [Token(1)]; }
say bag = make();
try {
    say y = bag[0];
    print("unreachable");
} catch (e) {
    print("clean caught"); // expect: clean caught
}
try {
    say z: opt = bag[0];
    print("unreachable");
} catch (e) {
    print("opt caught"); // expect: opt caught
}
