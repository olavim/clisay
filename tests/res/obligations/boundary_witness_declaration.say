type Wt { pub v; init(this, x) { this.v = x; } }
obligation warned { witness Wt; discharge to use; }
fn make() { return [Wt(1)]; }
say bag = make();
try { say y = bag[0]; print("unreachable"); }
catch (e) { print("thrown"); } // expect: thrown

// @split
trait Wt { }
obligation warned { witness Wt; discharge to use; }
type W with Wt { pub v; init(this, x) { this.v = x; } }
fn make() { return [W(1)]; }
say bag = make();
try { say y = bag[0]; print("unreachable"); }
catch (e) { print("trait thrown"); } // expect: trait thrown

// @split
type Wt { pub v; init(this, x) { this.v = x; } }
obligation warned { witness Wt; discharge to use; }
fn mk() { type Other { pub v; init(this, x) { this.v = x; } } return Other(2); }
say bag = [mk()];
try { say y = bag[0]; print("passed"); } // expect: passed
catch (e) { print("unreachable"); }

// @split
trait Wt { }
obligation warned { witness Wt; discharge to use; }
fn mk() { trait Other { } type W2 with Other { pub v; init(this, x) { this.v = x; } } return W2(2); }
say bag = [mk()];
try { say y = bag[0]; print("trait passed"); } // expect: trait passed
catch (e) { print("unreachable"); }
