// Laundering a `no persist` value through a mismatched return clause used to persist a borrow.
obligation borrowed { no persist; no return; }
type Taint { } obligation taint { witness Taint; discharge to use; }
type Box { pub mut item; init(this) { this.item = 0; } }
fn id(x: borrowed): taint { return x; } // error: cannot return a value owing 'borrowed'
fn go(y: borrowed) { say b = mut Box(); b.item = id(y)!; }
