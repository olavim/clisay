say b = { x: { y: null } };
say z = b["x"]["y"]; // error: Cannot assign a nullable value to non-null binding 'z'

// @split
say b = { x: { y: 1 } };
say z = b["x"]["y"];
print(z); // expect: 1

// @split
say a = [[null]];
say z = a[0][0]; // error: Cannot assign a nullable value to non-null binding 'z'

// @split
type Raw { } obligation taint { witness Raw; discharge to use; }
say var a = [[1]];
a[0][0] = Raw();
try { say z = a[0][0]; print("unreachable"); }
catch (e) { print("nested write forgotten"); } // expect: nested write forgotten

// @split
type Raw { } obligation taint { witness Raw; discharge to use; }
say var d = { "x": [1] };
d["x"][0] = Raw();
try { say z = d["x"][0]; print("unreachable"); }
catch (e) { print("field write forgotten"); } // expect: field write forgotten

// @split
type Token { pub v; init(this, x) { this.v = x; } }
obligation parsed { witness Token; discharge to use; }
fn make() { return [Token(1)]; }
say bag = make();
say a = [bag[0]];
try { say z = a[0]; print("unreachable"); }
catch (e) { print("unknown stays unknown"); } // expect: unknown stays unknown
