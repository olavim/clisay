trait Wt { }
obligation warned { witness Wt; discharge to use; }
fn f(): warned { type Inner with Wt { pub x; init(this) { this.x = 1; } } return Inner(); }
say v: warned = f();
print(v ?? "handled"); // expect: handled

// @split
trait Wt { }
obligation warned { witness Wt; discharge to use; }
fn f(): warned { type Inner with Wt { pub x; init(this) { this.x = 1; } } return Inner(); }
say v: warned = f();
if (v ~ Wt) { print("is the witness"); } // expect: is the witness
else { say y = v; print("discharged"); }

// @split
fn f()! { type Local { pub x; init(this) { this.x = 7; } } return Local(); }
print(f().x); // expect: 7
