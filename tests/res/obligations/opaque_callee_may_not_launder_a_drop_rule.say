trait Wt { }
obligation warned { witness Wt; must use; }
type W with Wt { }
fn stash(v) { say var sink = []; &sink.push(v); }
fn f() {
    say b: warned = W { };
    stash(b); // error: cannot pass a value owing 'warned'
    print(b ?? "handled");
}
f();

// @split
type Token { pub v; init(this, x) { this.v = x; } }
obligation parsed { witness Token; discharge to use; }
fn stash(v) { say var sink = []; &sink.push(v); }
fn f(g) {
    say b: parsed = Token(1);
    g(b); // error: Uncaught exception: <instance <type Token>>
}
f(stash);
