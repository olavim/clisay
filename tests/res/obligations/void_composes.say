fn maybe(k): opt { if (k) { return null; } return 1; }
fn readIt(k): fails { if (k) { return Err("x"); } return 1; }
fn logOpt(m): opt { maybe(false)?!; print(m); return m; }
fn logFails(m): fails { readIt(false)?!; print(m); return m; }
fn logBoth(m): opt fails { maybe(false)?!; readIt(false)?!; print(m); return m; }
logOpt("a")!; // expect: a
logFails("b")!; // expect: b
logBoth("c")!; // expect: c

// @split
fn readIt(k): fails { if (k) { return Err("x"); } return 1; }
fn logFails(m): void { readIt(false)?!; print(m); } // error: Cannot propagate from a void function
logFails("b");

// @split
fn readIt(k): fails { if (k) { return Err("x"); } return 1; }
fn logFails(m) { readIt(false)?!; print(m); } // error: 'logFails' returns a value owing 'fails' on some paths and no value on others
logFails("b");
