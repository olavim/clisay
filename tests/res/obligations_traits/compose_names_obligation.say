// A composer can name an obligation on the trait's exposed surface, since lexical nesting keeps it in scope.
type Tainted { } obligation tainted { witness Tainted; discharge to use; }
trait Sink {
    req fn accept(this, x: tainted);
}
type Db with Sink {
    pub fn accept(this, x: tainted) { }
    init(this) {}
}
say d = Db();
print("ok"); // expect: ok
