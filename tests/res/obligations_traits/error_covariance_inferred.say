// A satisfier's inferred return obligation is caught, not just a declared one.
fn risky(): fails { return Err("x"); }
trait Loader {
    req fn load(this);
}
type App with Loader {
    pub fn load(this) { return risky()?!; } // error: return owes an obligation the trait forbids
    init(this) {}
}
print("unreachable");
