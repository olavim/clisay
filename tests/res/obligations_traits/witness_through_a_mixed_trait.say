// A trait mixing the witness provides it too.
trait Wt { }
trait Outer with Wt { }
obligation warned { witness Wt; discharge to use; }
type T with Outer { pub x; init(this) { this.x = 1; } }
fn f(): warned { return T(); }
fn viaOuter(p @ Outer | null)! { return p.x; } // error: unchecked value owes 'opt', 'warned'

// @split
// Examining it through the outer name settles it, since that name reaches the witness.
trait Wt { }
trait Outer with Wt { }
obligation warned { witness Wt; discharge to use; }
type T with Outer { pub x; init(this) { this.x = 1; } }
fn f(): warned { return T(); }
say v: warned = f();
if (v ~ Outer) { print("matched"); } // expect: matched
print("end"); // expect: end

// @split
// The runtime test agrees with what the compiler read: the value matches both names.
trait Wt { }
trait Outer with Wt { }
obligation warned { witness Wt; discharge to use; }
type T with Outer { pub x; init(this) { this.x = 1; } }
fn f(): warned { return T(); }
say v: warned = f();
if (v ~ Outer) {
    print(v is Outer); // expect: true
    print(v is Wt); // expect: true
}
