print(!true);      // expect: false
print(!false);     // expect: true
print(!null);      // expect: true
print(!0);         // expect: false
print(!(1 == 2));  // expect: true
print(!(1 == 1));  // expect: false

fn once() {
    print("called");
    return false;
}
say r = !once();   // expect: called
print(r);          // expect: true
