type Box { pub data; init(this, d) { this.data = d; } }
fn peek(x @ Box { data }) {
    data[0] = 2; // error: cannot mutate an immutable value
}
peek(mut Box(mut [1]));

// @split
type Box { pub data; init(this, d) { this.data = d; } }
fn peek(mut Box { data }) {
    data.push(2);
}
say b = mut Box(mut [1]);
peek(b);
print(b.data[1]); // expect: 2

// @split
type Box { pub data; init(this, d) { this.data = d; } }
fn peek(x @ Box { data }) {
    print(data[0]);
    x.data.push(2);
}
say b = mut Box(mut [1]);
peek(b); // expect: 1
print(b.data[1]); // expect: 2

// @split
type Box { pub data; init(this, d) { this.data = d; } }
fn peek(x @ Box { data }) {
    print(data[0]);
}
peek(Box([7])); // expect: 7

// @split
type Box { pub data; init(this, d) { this.data = d; } }
fn peek(x @ Box) {
    match x {
        Box { data } => data.push(2),
        _ => print("no"),
    }
}
say b = mut Box(mut [1]);
peek(b);
print(b.data[1]); // expect: 2
