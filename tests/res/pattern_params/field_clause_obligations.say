type Raw { } obligation taint { witness Raw; discharge to use; }
type Box { pub item: taint; init(this, v: taint) { this.item = v; } }
fn make(): taint { return Raw(); }
say b = Box(make());
say x = b.item; // error: cannot assign a value owing 'taint' to 'x'

// @split
type Raw { } obligation taint { witness Raw; discharge to use; }
type Box { pub item: taint; init(this, v: taint) { this.item = v; } }
fn make(): taint { return Raw(); }
say b = Box(make());
if (b ~ Box { item }) {
    say x = item; // error: cannot assign a value owing 'taint' to 'x'
}

