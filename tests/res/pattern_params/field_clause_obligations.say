// @split
type Raw { } obligation taint { witness Raw; discharge to use; }
type Box { pub items: [taint]; init(this, v: [taint]) { this.items = v; } }
fn make(): [taint] { return [Raw()]; }
say b = Box(make());
say c: [taint] = b.items;
print("ok"); // expect: ok

