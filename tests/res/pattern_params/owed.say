// A witness alternative is the real obligation: it lands on the whole value and flows to the
// binders under it, and a discharge clears it just as a `:` clause obligation would. The nested case
// uses a user witness, since `fails` cannot live in a field.
obligation stale { witness Old; discharge to use; }
type Old { }
type Node { pub next: stale; init(this, n: stale) { this.next = n; } }

fn whole(x @ Node | null) {
    print(x ?? "none"); // expect: none
}
whole(null);

fn flowed(x @ Node { next } | null) {
    print(next ?? "none"); // expect: 7
}
flowed(Node(7));

fn nested(x @ Node { next: y @ Node | Old } | null) {
    print(y ?? "none"); // expect: none
}
nested(Node(Old{}));
