// @split
type P { pub v; init(this, v) { this.v = v; } }
type Q { pub v; init(this, v) { this.v = v; } }
trait Mover { req fn onMove(this, { k: P }); }
type Bound with Mover {
    init(this) { }
    pub fn onMove(this, { k: inner @ Q }) { } // error: parameter accepts less than the trait declares
}

// @split
type P { pub v; init(this, v) { this.v = v; } }
trait Mover { req fn onMove(this, { k: named @ P })!; }
type Bound with Mover {
    init(this) { }
    pub fn onMove(this, { k: P })! { return 1; }
}
print(Bound().onMove({ k: P(1) })); // expect: 1
