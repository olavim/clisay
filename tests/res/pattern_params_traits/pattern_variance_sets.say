// @split
type P { pub v; init(this, *v) { this.v = v; } }
type Q { pub v; init(this, *v) { this.v = v; } }

trait Mover { req fn onMove(this, a @ P, b); }
type Mixed with Mover {
    init(this) { }
    pub fn onMove(this, a, b @ Q) { } // error: parameter accepts less than the trait declares
}

// @split
trait Shaped { req fn read(this, x); }
type Structural with Shaped {
    init(this) { }
    pub fn read(this, x @ has Shaped) { } // error: parameter accepts less than the trait declares
}

