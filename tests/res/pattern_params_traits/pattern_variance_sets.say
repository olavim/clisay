type P { pub v; init(this, *v) { this.v = v; } }
type Q { pub v; init(this, *v) { this.v = v; } }

trait Mover { req fn onMove(this, x @ P | Q); }
type Half with Mover {
    init(this) { }
    pub fn onMove(this, x @ P) { } // error: parameter accepts less than the trait declares
}

// @split
type P { pub v; init(this, *v) { this.v = v; } }
type Q { pub v; init(this, *v) { this.v = v; } }

trait Mover { req fn onMove(this, x @ P | Q)!; }
type Swapped with Mover {
    init(this) { }
    pub fn onMove(this, x @ Q | P)! { return "took"; }
}
print(Swapped().onMove(P(1))); // expect: took

