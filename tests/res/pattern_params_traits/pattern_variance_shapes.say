type Outer { pub inner; init(this, *i) { this.inner = i; } }

trait Mover { req fn onMove(this, x @ Outer { inner: Inner { n } })!; }
type Shallower with Mover {
    init(this) { }
    pub fn onMove(this, x @ Outer)! { return x.inner.n; }
