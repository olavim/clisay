// @split
type Inner { pub n; init(this, *n) { this.n = n; } }
type Outer { pub inner; init(this, *i) { this.inner = i; } }

trait Mover { req fn onMove(this, x @ Outer { inner: Inner { n } })!; }
type Anything with Mover {
    init(this) { }
    pub fn onMove(this, x)! { return x.inner.n; }
}
print(Anything().onMove(Outer(Inner(3)))); // expect: 3
