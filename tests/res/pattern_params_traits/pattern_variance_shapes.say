type P { pub v; init(this, *v) { this.v = v; } }

trait Mover { req fn onMove(this, x @ P)!; }
type Binds with Mover {
    init(this) { }
    pub fn onMove(this, x @ P { v })! { return v; }
}
print(Binds().onMove(P(5))); // expect: 5

// @split
type P { pub v; init(this, *v) { this.v = v; } }

trait Mover { req fn onMove(this, x @ P); }
type Tests with Mover {
    init(this) { }
    pub fn onMove(this, x @ P { v: 1 }) { } // error: parameter accepts less than the trait declares
}

// @split
type P { pub v; init(this, *v) { this.v = v; } }

trait Mover { req fn onMove(this, x @ P { v })!; }
type Drops with Mover {
    init(this) { }
    pub fn onMove(this, x @ P)! { return x.v; }
}
print(Drops().onMove(P(6))); // expect: 6

// @split
type P { pub v; init(this, *v) { this.v = v; } }

trait Mover { req fn onMove(this, x @ P { v: 1 })!; }
type Same with Mover {
    init(this) { }
    pub fn onMove(this, x @ P { v: 1 })! { return "one"; }
}
print(Same().onMove(P(1))); // expect: one

// @split
type Inner { pub n; init(this, *n) { this.n = n; } }
type Outer { pub inner; init(this, *i) { this.inner = i; } }

trait Mover { req fn onMove(this, x @ Outer); }
type Deep with Mover {
    init(this) { }
    pub fn onMove(this, x @ Outer { inner: Inner { n } }) { } // error: parameter accepts less than the trait declares
}

// @split
type Inner { pub n; init(this, *n) { this.n = n; } }
type Outer { pub inner; init(this, *i) { this.inner = i; } }

trait Mover { req fn onMove(this, x @ Outer)!; }
type Shallow with Mover {
    init(this) { }
    pub fn onMove(this, x @ Outer { inner })! { return inner.n; }
}
print(Shallow().onMove(Outer(Inner(7)))); // expect: 7

