type Raw { } obligation taint { witness Raw; discharge to use; }
trait Holder {
    req var count : opt;
    req token : taint;
    req plain;
    pub fn clear(var this) { this.count = null; return this.count ?? this.plain; }
}
type Box with Holder {
    pub var count: opt;
    pub token: taint;
    pub plain;
    init(this, count, token: taint, plain) { this.count = count; this.token = token; this.plain = plain; }
}
print(Box(1, Raw(), 2).clear()); // expect: 2

// @split
trait Failing {
    req r : fails; // error: A required member cannot owe 'fails'
}

// @split
trait Tainting {
    req token : nope; // error: Obligation 'nope' is not declared
}
