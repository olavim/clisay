trait Counter {
    req var count;
    req data : opt;
    pub fn read(this)! { return 1; }
}
type Box with Counter {
    pub var count;
    pub data?;
    init(this, count, data?) { this.count = count; this.data = data; }
}
print(Box(1, null).read()); // expect: 1

// @split
type W { } obligation taint { witness W; discharge to use; }
trait Reader {
    req data : opt taint;
    pub fn read(this)! { return 1; }
}
type Box with Reader {
    pub data?;
    init(this, data?) { this.data = data; }
}
print(Box(null).read()); // expect: 1

// @split
trait Counter {
    req var count;
    pub fn read(this)! { return 1; }
}
type Box with Counter {
    pub count; // error: member `count` does not satisfy `Counter.count`
    init(this, count) { this.count = count; }
}

// @split
type W { } obligation taint { witness W; discharge to use; }
trait Reader {
    req data : opt;
    pub fn read(this)! { return 1; }
}
type Box with Reader {
    pub data: opt taint; // error: member `data` does not satisfy `Reader.data`
    init(this, data: opt taint) { this.data = data; }
}

// @split
trait Clearer {
    req var field : opt;
    pub fn clear(mut this) { this.field = null; }
}
type Box with Clearer {
    pub var field; // error: member `field` does not satisfy `Clearer.field`
    init(this, field) { this.field = field; }
}

// @split
trait Reader {
    req data : opt;
    pub fn read(this)! { return 1; }
}
type Box with Reader {
    pub fn data(this)! { return 5; } // error: member `data` does not satisfy `Reader.data`
    init(this) {}
}
