type Counter {
    var n;
    init(this) { this.n = 0; }
    pub fn bump(&var this) { this.n = this.n + 1; }
    pub fn twice(this) { &this.bump(); } // error: Cannot anchor non-var binding `this`
}

// @split
type Counter {
    pub var n;
    init(this) { this.n = 0; }
    pub fn bump(&var this) { this.n = this.n + 1; }
    pub fn twice(&var this) { &this.bump(); &this.bump(); }
}
say var c = Counter();
&c.twice();
print(c.n); // expect: 2

// @split
type Counter {
    pub var n;
    init(this) { this.n = 0; }
    pub fn bump(&var this) { this.n = this.n + 1; }
    pub fn twice(var this) { &this.bump(); &this.bump(); return this.n; }
}
say var c = Counter();
print(c.twice()); // expect: 2
print(c.n); // expect: 0
