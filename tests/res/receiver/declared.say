// Every method declares its receiver. `this: mut` is what lets one write the instance, and an
// obligation in the clause makes `this` owe it until the body discharges it.
type Counter {
    var n;
    init(this, *start) { this.n = start; }

    pub fn value(this)! { return this.n; }
    pub fn bump(this: mut) { this.n = this.n + 1; }
}

say c = mut Counter(1);
print(c.value()); // expect: 1
c.bump();
print(c.value()); // expect: 2
