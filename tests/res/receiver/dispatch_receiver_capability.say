// The call settles the receiver capability, not the reference.
type T { pub fn f(this: mut) {} }
say t = mut T {};
say g = t.f;
freeze(t);
g(); // error: `T.f` declares `this: mut`, but its receiver is immutable

// @split
// Taking a reference to a mutable receiver method on an immutable receiver is allowed, but calling the reference traps.
type T { pub fn f(this: mut) {} }
say t = T {};
say g = t.f;
g(); // error: `T.f` declares `this: mut`, but its receiver is immutable

// @split
// A body that writes is refused at the same place, not inside itself.
type T { pub var n; init(this) { this.n = 0; } pub fn f(this: mut) { this.n = 9; } }
say t = mut T();
say g = t.f;
freeze(t);
g(); // error: `T.f` declares `this: mut`, but its receiver is immutable

// @split
// A live mutable receiver still calls through a reference.
type T { pub var n; init(this) { this.n = 0; } pub fn f(this: mut) { this.n = 9; } }
say t = mut T();
say g = t.f;
g();
print(t.n); // expect: 9

// @split
// A read-only method has nothing to satisfy, so freezing its receiver changes nothing.
type T { pub var n; init(this) { this.n = 7; } pub fn get(this)! { return this.n; } }
say t = mut T();
say g = t.get;
freeze(t);
print(g()); // expect: 7

// @split
// A native method declares no `this`, so it keeps its own rule and the check pass still gets it
// first when the freeze is in plain sight.
say a = mut [1];
freeze(a);
a.push(2); // error: expected mutable receiver

// @split
// A factory's `this` belongs to whoever constructs the value, so building one is not a call on an
// immutable receiver.
type T { pub var n; init(this) { this.n = 1; } pub fn f(this: mut) { this.n = 2; } }
say t = mut T();
t.f();
print(t.n); // expect: 2
