// A lambda in a method body writes through the enclosing `this`, so it needs the same receiver.
type Counter {
    mut n;
    init(this) { this.n = 0; }
    pub fn bump(this) {
        say f = () => { this.n = this.n + 1; }; // error: cannot assign `Counter.n` through a read-only receiver
        f();
    }
}
