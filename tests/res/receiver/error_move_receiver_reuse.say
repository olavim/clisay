// A `*mut` receiver takes the instance's write-ownership. The caller reads it still, and the
// method's own write shows through.
type Box {
    pub var item;
    init(this) { this.item = 0; }
    pub fn consume(*mut this) { this.item = 1; }
    pub fn peek(this)! { return this.item; }
}

say b = mut Box();
b.consume();
print(b.peek()); // expect: 1
