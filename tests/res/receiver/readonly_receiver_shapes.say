// Every way of mutating through the receiver needs the method to declare `this: mut`, not just a
// direct field assignment.
type T { pub var n; init(this) { this.n = 0; } pub fn f(this) { this.n = 1; } } // error: cannot assign `T.n` through a read-only receiver

// @split
type T { pub arr; init(this) { this.arr = mut [0]; } pub fn f(this) { this.arr[0] = 1; } } // error: cannot mutate through a read-only receiver

// @split
fn take(mut a) { a.push(1); }
type T { pub arr; init(this) { this.arr = mut []; } pub fn f(this) { take(this.arr); } } // error: expected mutable argument

// @split
type I { pub var v; init(this) { this.v = 0; } }
type T { pub inner; init(this) { this.inner = mut I(); } pub fn f(this) { this.inner.v = 1; } } // error: cannot mutate through a read-only receiver

// @split
// Naming a member is not calling it, so taking `t.set` is allowed whatever the receiver is.
type T { pub var x?; pub fn set(mut this, *v) { this.x = v; } }
say t = T {};
say f = t.set;
print("named"); // expect: named

// @split
// The same program with a mutable receiver runs, so the rule refuses only what it should.
fn take(mut a) { a.push(1); }
type I { pub var v; init(this) { this.v = 0; } }
type T {
    pub var n; pub arr; pub inner;
    init(this) { this.n = 0; this.arr = mut [0]; this.inner = mut I(); }
    pub fn f(mut this) { this.n = 1; this.arr[0] = 2; this.arr.push(3); take(this.arr); this.inner.v = 4; }
}
say t = mut T();
t.f();
print(t.n); // expect: 1
print(t.arr[0]); // expect: 2
print(t.inner.v); // expect: 4

// @split
// A factory builds the instance, so its own writes are not receiver mutations.
type T { pub arr; init(this) { this.arr = mut []; this.arr.push(9); this.arr[0] = 8; } }
say t = mut T();
print(t.arr[0]); // expect: 8
