type W { pub b; init(this, b) { this.b = b; } }
fn maybe(x): opt { if x { return W(Ref(7)); } return null; }

say w: opt = maybe(true);
print(w?.@b ?? 0); // expect: 7

say none: opt = maybe(false);
print(none?.@b ?? 0); // expect: 0

say arr = [W(Ref(3))];
print(arr[0]?.@b ?? 0); // expect: 3

say ok: opt = maybe(true);
ok!.@b = 5;
print(ok!.@b); // expect: 5

// @split
type W { pub b; init(this, b) { this.b = b; } }
fn maybe(x): opt { if x { return W(Ref(7)); } return null; }
say w: opt = maybe(true);
w?.@b = 5;
print(w?.@b ?? 0); // expect: 5
say none: opt = maybe(false);
none?.@b = 5;
print(none?.@b ?? 0); // expect: 0
