say r = Ref(1);

type Box { pub b; init(this, b) { this.b = b; } }
say one = Box(r);
say two = one;
two.@b = 7;
print(one.@b); // expect: 7
print(@r); // expect: 7

say held = [r];
@(held[0]) = 8;
print(@r); // expect: 8

say bump = () => { r.update(n => n + 1); };
bump();
bump();
print(@r); // expect: 10
