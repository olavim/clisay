// Casing is grammatical: a type/trait is uppercase, a value is lowercase.
type point { init(this) { } } // error: a type name must start with an uppercase letter
// @split
fn Render() { } // error: an fn name must start with a lowercase letter
// @split
say Total = 1; // error: a variable name must start with a lowercase letter
// @split
try { } catch (X) { } // error: a parameter name must start with a lowercase letter
// @split
trait drawable { } // error: a trait name must start with an uppercase letter
