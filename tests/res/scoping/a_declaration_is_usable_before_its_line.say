print(f()); // expect: 1
fn f()! { return 1; }
say t = T{ v: 2 };
print(t.v); // expect: 2
type T { pub v; }

// @split
{
    print(f()); // expect: 3
    fn f()! { return 3; }
}

// @split
fn a(n)! { if (n <= 0) { return 0; } return b(n - 1); }
fn b(n)! { return a(n) + 1; }
print(b(3)); // expect: 4
type P { pub fn mk(this)! { return Q{ w: 5 }; } }
type Q { pub w; }
print(P{}.mk().w); // expect: 5

// @split
say x = 6;
print(f()); // expect: 6
fn f()! { return x; }
say outer = 7;
say c = C();
type C { pub fn grab(this)! { return outer; } }
print(c.grab()); // expect: 7

// @split
fn f()! { return x; } // error: Undefined variable 'x'
say x = 1;
f();
