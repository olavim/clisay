// @split
fn g(&var h) { return h(); }
fn run() {
    fn a() { return b(); }
    say var f = () => a();
    g(&f); // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return 0;
}
run();

// @split
fn run() {
    fn a() { return b(); }
    say var f = () => a();
    f = () => 5;
    say x = f();
    say q = 2;
    fn b() { return q; }
    return x;
}
print(run()); // expect: 5

// @split
fn run(c) {
    fn a() { return b(); }
    say var f = () => 0;
    if (c) { f = () => a(); }
    say x = f(); // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return x;
}
run(false);

// @split
fn run(c) {
    fn a() { return b(); }
    say var f = () => 0;
    say var k = c;
    while (k) { f = () => a(); k = false; }
    say x = f(); // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return x;
}
run(true);

// @split
fn run() {
    fn a() { return b(); }
    say var f = () => a();
    say var k = true;
    while (k) { f = () => 5; k = false; }
    say q = 2;
    fn b() { return q; }
    return f();
}
print(run()); // expect: 5

// @split
fn run(c) {
    fn a() { return b(); }
    say var f = () => 0;
    c && (f = () => a()) != null;
    say x = f(); // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return x;
}
run(true);

// @split
fn g() { throw "e"; }
fn run() {
    fn a() { return b(); }
    say var f = () => 0;
    try { f = () => a(); g(); f = () => 1; } catch (e) { f(); } // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return 0;
}
run();

// @split
fn put(&var s, early) {
    fn a() { return b(); }
    s = () => a(); // error: This function cannot be used yet, because it uses 'b', which is declared below
    if (early) { return 0; }
    say q = 2;
    fn b() { return q; }
    return 0;
}
say var k = () => 0;
put(&k, true);

// @split
fn put(&var s) {
    fn a() { return 7; }
    s = () => a();
    return 0;
}
say var k = () => 0;
put(&k);
print(k()); // expect: 7

// @split
fn run(early) {
    fn a() { return b(); }
    say var f = () => 0;
    defer { print(f()); }
    f = () => a(); // error: This function cannot be used yet, because it uses 'b', which is declared below
    if (early) { return 0; }
    say q = 2;
    fn b() { return q; }
    return 0;
}
run(true);

// @split
fn run() {
    fn a() { return b(); }
    say var f = () => 0;
    defer { print(1); } // expect: 1
    f = () => a();
    say q = 2;
    fn b() { return q; }
    return f();
}
print(run()); // expect: 2

// @split
fn t() { throw "e"; }
fn run() {
    fn a() { return b(); }
    say var f = () => 0;
    try { t(); } catch (e) { f = () => a(); throw "again"; } finally { print(f()); } // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return 0;
}
run();

// @split
fn h(v) { return v(); }
fn run() {
    fn a() { return b(); }
    say var f = () => 0;
    say x = h(f = () => a()); // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return x;
}
run();

// @split
fn h(v) { return v(); }
fn run() {
    fn a() { return 7; }
    say var f = () => 0;
    return h(f = () => a());
}
print(run()); // expect: 7
