fn run() {
    say p = 1;
    fn a() { return b() + p; }
    say f = () => a();
    say q = 2;
    fn b() { return q; }
    return f();
}
print(run()); // expect: 3

// @split
fn run() {
    fn a() { return b(); }
    say f = () => a();
    say x = f(); // error: 'f' cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return x;
}
run();

// @split
fn run() {
    fn a() { return b(); }
    say f = () => () => a();
    say q = 2;
    fn b() { return q; }
    return f()();
}
print(run()); // expect: 2

// @split
fn run() { fn a() { return 1; } return () => a(); }
print(run()()); // expect: 1

// @split
fn h(v) { return v(); }
fn run() { fn a() { return 1; } return h(() => a()); }
print(run()); // expect: 1

// @split
fn h(v) { return v(); }
fn run() {
    fn a() { return b(); }
    say x = h(() => a()); // error: This function cannot be used yet, because it uses 'b', which is declared below
    say q = 2;
    fn b() { return q; }
    return x;
}
run();

// @split
fn run() {
    fn a() { return b(); }
    say arr = [() => a()];
    say q = 2;
    fn b() { return q; }
    return arr[0]();
}
print(run()); // expect: 2

// @split
fn run() {
    fn a() { return b(); }
