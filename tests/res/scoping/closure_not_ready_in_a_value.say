// @split
fn run() {
    fn a() { return b(); }
    say var d = { c: 0 };
    d["c"] = () => a();
    d["c"] = () => 1;
    say x = d["c"]();
    say q = 2;
    fn b() { return q; }
    return x;
}
print(run()); // expect: 1

