fn run() { say a; a = 1; return a; }
print(run()); // expect: 1

// @split
fn dirty() { say var x = 77; return x; }
fn run() { say a; return a; } // error: 'a' is used before it is assigned
dirty();
print(run());

// @split
fn run() { say a: opt; a = 1; return a; }
print(run()); // expect: 1

// @split
fn run() { say a: opt; return a; } // error: 'a' is used before it is assigned
print(run());

// @split
fn run() { say a; a = 1; fn g() { return a; } return g(); }
print(run()); // expect: 1

// @split
fn f(c) { say a; if (c) { a = 1; } say g = () => a; return g(); } // error: 'a' is used before it is assigned
print(f(true));

// @split
fn run() { say var a = 0; a = 1; fn g() { return a; } return g(); }
print(run()); // expect: 1

// @split
fn run() { say a; { a = 1; fn g() { return a; } return g(); } }
print(run()); // expect: 1

// @split
fn g() { throw "e"; }
fn run() { say x; try { g(); x = 1; } catch (e) { print(x); } } // error: 'x' is used before it is assigned
run();

// @split
fn g() { throw "e"; }
fn run() { say x; try { g(); x = 1; } finally { print(x); } } // error: 'x' is used before it is assigned
run();

// @split
fn g() { return 1; }
fn run() { say x; try { x = g(); } catch (e) { return 0; } return x; }
print(run()); // expect: 1

// @split
fn g() { return 1; }
fn run() { say x; try { x = g(); } catch (e) { x = 2; } return x; }
print(run()); // expect: 1

// @split
fn g() { return 1; }
fn run() { say x; try { x = g(); } catch (e) { print(e); } return x; } // error: 'x' is used before it is assigned
print(run());

// @split
fn run() {
    say v;
    type T { pub v = 1; pub fn get(this) { return this.v; } }
    v = 2;
    return T().get() + v;
}
print(run()); // expect: 3

// @split
fn run() { { defer { print(b()); } say q = 2; fn b() { return q; } } } // error: 'b' is used before its declaration
run();

// @split
fn run() { defer { print(a); } say a = 1; } // error: Undefined variable 'a'
run();

// @split
fn g() { return 1; }
fn h() { throw "e"; }
fn run() {
    say f;
    try { h(); f = g; } catch (e) { print(e); }
    return f(); // error: 'f' is used before it is assigned
}
run();
