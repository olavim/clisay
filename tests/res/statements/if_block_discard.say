say a = 0;
if (true) { a = 1; }
print(a); // expect: 1

say b = 0;
if (false) { b = 1; }
print(b); // expect: 0

say c = 0;
if (false) { c = 1; } else { c = 2; }
print(c); // expect: 2

say d = 0;
if (false) { d = 1; } else if (true) { d = 2; } else { d = 3; }
print(d); // expect: 2

say e = 0;
{ e = 5; }
print(e); // expect: 5
