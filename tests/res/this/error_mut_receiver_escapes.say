// A `mut` receiver is lent for the call. A closure holding it is a new value that outlives the
// lend, so returning one is refused even though calling it in place is fine.
type Counter {
    pub mut n;
    init(this) { this.n = 0; }
    pub fn leak(this: mut)! { return () => { this.n = 1; }; } // error: a `mut` receiver borrows the instance and cannot let it escape
}
