// A lambda in a method body captures the enclosing `this`, through any depth of nesting. A closure
// over a `mut` receiver may be called in place; only one that outlives the call is refused.
type Counter {
    pub var n;
    init(this) { this.n = 0; }

    pub fn show(this) { say f = () => print(this.n); f(); }
    pub fn nested(this) { say f = () => { say g = () => print(this.n); g(); }; f(); }
    pub fn bump(mut this) { say f = () => { this.n = this.n + 1; }; f(); }
    pub fn reader(this)! { return () => this.n; }
}

say c = mut Counter();
c.show();   // expect: 0
c.bump();
c.show();   // expect: 1
c.nested(); // expect: 1

say read = c.reader();
print(read()); // expect: 1
c.bump();
print(read()); // expect: 2
