// Provide-once: a trait declared by both `with` and `gives` is a collision.
trait Powered { pub fn start(this) { return "vroom"; } }
type Engine with Powered { init(this) {} }

type Car with Powered { // error: Trait 'Powered' appears in both `with` and `gives`
    engine gives Powered;
    init(this) { this.engine = Engine(); }
}
