// Two different traits exposing a method of the same name clash; without a host override to
// resolve it, that is a compile error.
trait Logger  { pub fn log(this, m) { print("log"); } }
trait Auditor { pub fn log(this, m) { print("audit"); } }
type Service with Logger, Auditor { init(this) {} } // error: Exposed method 'log' clashes between traits 'Logger' and 'Auditor'
