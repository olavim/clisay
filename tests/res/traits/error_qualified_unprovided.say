// A qualified call `T.method(...)` is valid only for a trait the enclosing type provides.
trait Other  { pub fn foo(this) { return 1; } }
trait Logger { pub fn log(this) { return 2; } }

type X with Logger {
    pub fn bar(this) { return Other.foo(); } // error: 'Other.foo(...)': 'Other' is not a trait provided by this type
    init(this) {}
}
say x = X();
print(x.bar());
