// A header allows at most one `with` clause then one `req` clause; repeats/interleaving are errors.
trait Y { pub fn y(this) { return 1; } }
trait Z { pub fn z(this) { return 2; } }
type X with Y with Z { init(this) {} } // error: Unexpected 'with' clause

// @split

trait Y { pub fn y(this) { return 1; } }
trait Z { pub fn z(this) { return 2; } }
trait X with Y with Z { init(this) {} } // error: Unexpected 'with' clause

// @split

trait Y { pub fn y(this) { return 1; } }
trait Z { pub fn z(this) { return 2; } }
trait X req Y with Z { init(this) {} } // error: Unexpected 'with' clause

// @split

trait Y { pub fn y(this) { return 1; } }
trait Z { pub fn z(this) { return 2; } }
trait X req Y req Z { init(this) {} } // error: Unexpected 'req' clause

// @split

trait A { pub fn a(this) { return 1; } }
trait B { pub fn b(this) { return 2; } }
trait C { pub fn c(this) { return 3; } }
trait D with A req B with C { init(this) {} } // error: Unexpected 'with' clause

// @split

trait A { pub fn a(this) { return 1; } }
trait B { pub fn b(this) { return 2; } }
trait C { pub fn c(this) { return 3; } }
trait D with A req B req C { init(this) {} } // error: Unexpected 'req' clause