// A composer may not both `with`-provide and `req`-depend on the same trait.
trait Clock { pub fn tick(this) { return 1; } }
trait Player with Clock req Clock { } // error: Trait 'Clock' appears in both `with` and `req`
// @split
trait Clock { pub fn tick(this) { return 1; } }
type Player with Clock { clock gives Clock; } // error: Trait 'Clock' appears in both `with` and `gives`
