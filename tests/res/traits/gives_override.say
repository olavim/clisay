// Delegate-and-customize: the host overrides one forwarded method; the rest still forward.
trait Powered {
    pub fn start(this)! { return "vroom"; }
    pub fn stop(this)! { return "stop"; }
}
type Engine with Powered { init(this) {} }

type Car {
    engine gives Powered;
    pub fn start(this)! { return "custom"; }
    init(this) { this.engine = Engine(); }
}

say c = Car();
print(c.start());    // expect: custom
print(c.stop());     // expect: stop
print(c is Powered); // expect: true
