trait Counter {
    fn step(this) { return 1; }
    pub fn bump(this) { return this.step() + this.step(); }
    pub fn shadow(this, step) { return step; } // a parameter named like the private method
}
trait Other {
    fn step(this) { return 100; }
    pub fn other(this) { return this.step(); }
}
type Widget with Counter, Other { init(this) {} }
say w = Widget();
print(w.bump());     // expect: 2
print(w.shadow(40)); // expect: 40
print(w.other());    // expect: 100
