trait Logger  { pub fn log(this, m) { print(m + " [log]"); } }
trait Auditor { pub fn log(this, m) { print(m + " [audit]"); } }

type Service with Logger, Auditor {
    pub fn log(this, m) {
        Logger.log(m);
        Auditor.log(m);
    }
    init(this) {}
}

say s = Service();
s.log("hi");
// expect: hi [log]
// expect: hi [audit]
