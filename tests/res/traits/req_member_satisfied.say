trait Counter {
    req var count;
    pub fn inc(&var this) { this.count = this.count + 1; }
    pub fn get(this) { return this.count; }
}
type Widget with Counter {
    pub var count = 0;
    init(this) {}
}

say var w = Widget();
&w.inc();
&w.inc();
print(w.get());  // expect: 2
print(w.count);  // expect: 2
