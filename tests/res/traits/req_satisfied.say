trait Clock { pub fn tick(this)! { return 1; } }
trait Mover req Clock {
    req fn onMove(this, d)!;
    pub fn step(this)! { return this.tick() + this.onMove(2); }
}
type Player with Mover, Clock {
    inner fn onMove(this, d)! { return d * 10; }
    init(this) {}
}
say p = Player();
print(p.step()); // expect: 21
