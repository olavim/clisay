trait Tagged { pub fn tag(this)! { return "TOP"; } }

fn makeInner()! {
    trait Tagged { pub fn tag(this)! { return "INNER"; } }
    type Widget with Tagged { init(this) {} }
    return Widget();
}

type OuterThing with Tagged { init(this) {} }

print(makeInner().tag()); // expect: INNER
print(OuterThing().tag()); // expect: TOP
