fn helper(n) { return n + 100; }

trait Clock { pub fn tick(this) { return 1; } }

trait Mover req Clock {
    req count;
    req speed;
    req fn onMove(this, d);
    pub fn step(this, dir) {
        say local = dir;
        return this.tick()
             + this.speed
             + this.onMove(local)
             + helper(this.count);
    }
}
type Player with Mover, Clock {
    pub count = 0;
    pub speed = 2;
    inner fn onMove(this, d) { return d; }
    init(this) {}
}
say p = Player();
print(p.step(5)); // expect: 108
