// A type declaration masks an outer trait of the same name, exactly as it masks an outer type.
trait Tr { pub fn go(this)! { return "outer-trait"; } }
fn f()! { type Tr { pub a; init(this) { this.a = 9; } } return Tr(); }
print(f().a); // expect: 9

// @split
// A type mixing the trait where nothing masks it still reaches it.
trait Tr { pub fn go(this)! { return "outer-trait"; } }
type Host with Tr { pub h; init(this) { this.h = 1; } }
print(Host().go()); // expect: outer-trait

// @split
// The mask reaches `with` too: the name resolves to the type in scope, which cannot be mixed.
trait Tr { pub fn go(this)! { return "outer-trait"; } }
fn f()! {
    type Tr { pub a; init(this) { this.a = 9; } }
    type U with Tr { pub b; init(this) { this.b = 2; } } // error: Trait 'Tr' is not declared
    return U();
}
