fn other() { type T { pub var x; init(this) { this.x = 1; } } say u = T(); u.x = 5; }
fn mk() {
    type T { pub x; init(this) { this.x = 1; } }
    say v = T();
    v.x = 99; // error: Cannot reassign field `T.x`
}

// @split
fn other() { type T { pub var x?; init(this) { this.x = null; } } }
fn mk() {
    type T { pub var x; init(this) { this.x = 1; } }
    say v = T();
    v.x = null; // error: Cannot assign null to non-null field 'x'
}

// @split
fn other() { type T { pub x; init(this) { this.x = 1; } } }
fn mk() {
    type T { pub var x; init(this) { this.x = 1; } }
    say v = T();
    v.x = 2;
    print(v.x); // expect: 2
}
mk();

// @split
trait Wt { }
obligation warned { witness Wt; must use; }
fn f() {
    trait Other { }
    type W2 with Other { }
    say b = W2();
    print("built"); // expect: built
}
f();
