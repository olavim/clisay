// A value's declared facts come from the declaration it was built from, not from another one
// sharing the name. Mutability, nullability, and what a construction owes all read that declaration.
fn other() { type T { pub mut x; init(this) { this.x = 1; } } say u = mut T(); u.x = 5; }
fn mk() {
    type T { pub x; init(this) { this.x = 1; } }
    say v = mut T();
    v.x = 99; // error: Cannot assign immutable field `T.x`
}

// @split
fn other() { type T { pub mut x?; init(this) { this.x = null; } } }
fn mk() {
    type T { pub mut x; init(this) { this.x = 1; } }
    say v = mut T();
    v.x = null; // error: Cannot assign null to non-null field 'x'
}

// @split
// The same disagreement the other way round: the value's own declaration allows the write.
fn other() { type T { pub x; init(this) { this.x = 1; } } }
fn mk() {
    type T { pub mut x; init(this) { this.x = 1; } }
    say v = mut T();
    v.x = 2;
    print(v.x); // expect: 2
}
mk();

// @split
// Constructing a type that mixes a trait sharing no name with the witness owes nothing, since it
// is not the witness.
trait Wt { }
obligation warned { witness Wt; discharge before drop; }
fn f() {
    trait Other { }
    type W2 with Other { }
    say b = W2();
    print("built"); // expect: built
}
f();
