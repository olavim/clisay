// A type test names a declaration, not a name, so two declarations sharing a name are two
// different tests. Sibling scopes each name their own, and neither can name the other's.
fn mk()! { type T { pub x; init(this) { this.x = 1; } } return T(); }
fn probe() {
    type T { pub y; init(this) { this.y = 2; } }
    print(mk() is T); // expect: false
    print(T() is T); // expect: true
}
probe();

// @split
// The same through the match operator, which is the same test.
fn mk()! { type T { pub x; init(this) { this.x = 1; } } return T(); }
fn probe() {
    type T { pub y; init(this) { this.y = 2; } }
    print(mk() ~ T); // expect: false
    print(T() ~ T); // expect: true
}
probe();

// @split
// A trait mixed by both declarations is still provided by both, since each mixes the one trait.
trait Tr { }
fn mk()! { type T with Tr { pub x; init(this) { this.x = 1; } } return T(); }
fn probe() {
    type T with Tr { pub y; init(this) { this.y = 2; } }
    say v = mk();
    print(v is Tr); // expect: true
    print(v is T); // expect: false
}
probe();
