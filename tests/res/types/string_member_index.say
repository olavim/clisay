type Point {
    pub x = 1;
    pub var y = 2;
}

say var p = Point();
print(p["x"]); // expect: 1
print(p.x);    // expect: 1

p["y"] = 9;
print(p.y);    // expect: 9
print(p["y"]); // expect: 9

// @split
type Point {
    pub x = 1;
}

say var p = Point();
p["x"] = 9; // error: Cannot reassign field `Point.x`

// @split
type Holder {
    pub items = [0];
}

say var h = Holder();
h["items"][0] = 1; // error: Cannot reassign field `Holder.items`
