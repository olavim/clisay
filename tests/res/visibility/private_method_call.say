// A private method is callable internally (via `this`) but not externally.
type Service {
    fn helper(this)! { return 7; } // private method
    pub fn run(this)! { return this.helper(); } // internal call: ok
    init(this) {}
}
say s = Service();
print(s.run()); // expect: 7
// A private method is invisible externally, so the call is "no such member".
print(s.helper()); // error: Invalid index: Service doesn't have member "helper"
